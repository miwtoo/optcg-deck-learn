---
const { title, active, guideBase = '/elbaph-sabo', brand = 'ONE PIECE · OP17', navigation = ['Deck', 'Pilot', 'Combos'] } = Astro.props;
const base = `${import.meta.env.BASE_URL}${guideBase}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="mark" href={`${base}/`}>{brand}</a>
        <nav aria-label="Guide pages">
          {navigation.map((label: string) => <a class:list={{ active: active === label.toLowerCase() }} href={`${base}/${label === 'Deck' ? '' : `${label.toLowerCase()}/`}`}>{label}</a>)}
        </nav>
      </header>
      <slot />
    </main>
  </body>
</html>
<style is:global>
  :root{--ink:#11131d;--paper:#f5f1e8;--card:#fffdf7;--red:#e34c35;--gold:#f3c84b;--blue:#e4e0ff;--muted:#6f6d72;--line:#252631;--green:#dcefdc}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 ui-rounded,"Trebuchet MS",system-ui,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;background-image:radial-gradient(var(--ink) .6px,transparent .6px);background-size:8px 8px}a{color:inherit}.shell{position:relative;max-width:1180px;margin:auto;padding:22px 22px 90px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px}.mark{font-size:11px;font-weight:900;letter-spacing:.16em;text-decoration:none}.topbar nav{display:flex;gap:7px;flex-wrap:wrap}.topbar nav a,.button{border:2px solid var(--line);border-radius:99px;background:var(--card);padding:9px 15px;font-weight:900;text-decoration:none}.topbar nav a.active,.button{background:var(--gold)}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:42px;align-items:center;padding:74px 0 45px}.eyebrow,.label{color:var(--red);font-size:11px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.hero h1,.combo-intro h1{max-width:720px;margin:14px 0 20px;font-size:clamp(48px,9vw,105px);line-height:.83;letter-spacing:-.08em}.hero h1 em,.combo-intro h1 em{color:var(--red);font-style:normal}.lede{max-width:620px;font-size:19px;line-height:1.45}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.chip,.tag{display:inline-block;padding:5px 9px;border-radius:99px;background:var(--blue);font-size:11px;font-weight:900}.tag{padding:2px 6px}.hero-art{display:flex;justify-content:center;align-items:end;gap:15px;transform:rotate(3deg)}.hero-art img{width:min(28vw,205px);border:3px solid var(--line);border-radius:13px;box-shadow:10px 11px 0 var(--red)}.hero-art img+img{transform:translateY(35px) rotate(-7deg);box-shadow:10px 11px 0 var(--gold)}.section{margin-top:45px}.section h2{font-size:clamp(30px,5vw,52px);line-height:.95;margin:10px 0 18px;letter-spacing:-.05em}.notice{padding:16px 19px;border:2px solid var(--line);border-left:10px solid var(--red);border-radius:13px;background:var(--card);margin:15px 0}.source{color:var(--muted);font-size:12px}.overview,.lanes,.curve{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.tile,.lane,.panel,.keep,.pilot-step,.ideal-lane,.combo-card{border:2px solid var(--line);border-radius:15px;background:var(--card);padding:16px}.tile:nth-child(odd),.keep:nth-child(odd){background:#fff0bf}.tile h3,.lane h3,.panel h3{margin:0 0 8px}.flow{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-weight:900}.flow span{padding:12px 16px;border:2px solid var(--line);border-radius:99px;background:var(--gold)}.countline{display:flex;justify-content:space-between;align-items:end;gap:20px}.count{font-weight:900;color:var(--red)}.deck-group{margin:26px 0}.deck-group h3{border-bottom:2px solid var(--line);padding-bottom:7px}.deck-group h3 span{float:right;color:var(--muted);font-size:12px}.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.card{display:flex;flex-direction:column;text-align:left;gap:3px;border:2px solid var(--line);border-radius:13px;background:var(--card);padding:8px;cursor:pointer;box-shadow:5px 5px 0 var(--ink)}.card:hover{transform:translate(-2px,-2px)}.card-image{width:100%;aspect-ratio:0.68;object-fit:cover;border-radius:7px;background:var(--blue)}.card small{font-size:11px;color:var(--muted)}.card strong{font-size:14px}.qty{float:right;color:var(--red);font-weight:900}.modal{max-width:600px;border:2px solid var(--line);border-radius:18px;background:var(--card);padding:24px;box-shadow:9px 9px 0 var(--ink)}dialog::backdrop{background:#11131dcc}.modal-top{display:flex;gap:18px;align-items:start}.modal-top img{width:145px;border:2px solid var(--line);border-radius:8px}.modal h2{font-size:34px;line-height:.95;margin:8px 0}.close{float:right;border:0;background:transparent;font-size:28px;cursor:pointer}.pilot-flow{display:grid;gap:11px}.pilot-step{display:grid;grid-template-columns:48px 1fr;gap:14px}.step-no{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--ink);color:var(--gold);font-weight:950;font-size:18px}.guidance-art,.threshold-art,.ideal-pair{display:flex;gap:8px;flex-wrap:wrap}.guidance-art img,.threshold-art img,.ideal-pair img{width:64px;height:92px;object-fit:cover;border-radius:6px;border:1px solid var(--line)}.ideal-curve{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ideal-step{display:grid;grid-template-columns:76px 1fr;gap:12px;border-top:1px solid #d8d3c8;padding:13px 0}.ideal-step:first-of-type{border-top:0}.ideal-step>img{width:76px;height:110px;object-fit:cover;border-radius:7px;border:1px solid var(--line)}.ideal-step h4{margin:0 0 4px}.ideal-step p{margin:4px 0;font-size:12px}.combo-intro{padding:70px 0 34px;max-width:760px}.combo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.combo-card{padding:0;overflow:hidden;box-shadow:7px 8px 0 var(--ink)}.combo-card:nth-child(2){transform:translateY(24px);box-shadow:7px 8px 0 var(--gold)}.combo-art{display:flex;align-items:flex-end;gap:8px;min-height:230px;padding:18px;background:var(--blue)}.combo-art img{width:42%;max-width:150px;border:2px solid var(--line);border-radius:9px;box-shadow:5px 5px 0 var(--line)}.combo-art img+img{transform:translateY(18px) rotate(4deg)}.combo-copy{padding:18px}.combo-copy h2{margin:0 0 9px;font-size:25px;line-height:1}.combo-step{border-top:1px solid #d8d3c8;padding-top:11px;margin-top:11px;font-size:13px}.combo-step b{display:block;color:var(--red);font-size:11px;text-transform:uppercase}.shelf{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.shelf-card{display:flex;gap:9px;text-align:left;border:2px solid var(--line);background:var(--card);padding:8px;border-radius:10px}.shelf-card img{width:48px;height:69px;object-fit:cover}.shelf-card small{display:block;color:var(--muted);font-size:10px}@media(max-width:900px){.overview,.lanes,.curve{grid-template-columns:repeat(2,1fr)}.ideal-curve{grid-template-columns:1fr}.combo-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.shell{padding:16px}.topbar{align-items:flex-start;flex-direction:column}.hero{grid-template-columns:1fr;padding-top:48px}.hero-art{justify-content:flex-start}.hero-art img{width:40vw}.card-grid,.shelf,.overview,.lanes,.curve,.combo-grid{grid-template-columns:1fr 1fr}.combo-card:nth-child(2){transform:none}.ideal-step{grid-template-columns:64px 1fr}.ideal-step>img{width:64px;height:92px}}@media(max-width:390px){.card-grid,.shelf,.overview,.lanes,.curve,.combo-grid{grid-template-columns:1fr}}
</style>
<style is:global>
  .combo-open{display:inline-block;margin-top:8px}
  .combo-grid{align-items:stretch}
  .combo-card{height:100%;position:relative}
  .combo-card:nth-child(2){transform:none;box-shadow:7px 8px 0 var(--gold)}
  .combo-card:hover,.combo-card:focus-within{transform:translateY(-3px)}
  .combo-art{min-height:clamp(190px,26vw,250px);height:clamp(190px,26vw,250px);padding:14px;align-items:center;justify-content:center;gap:14px;overflow:hidden}
  .combo-art .card-image-button{width:calc((100% - 14px)/2);max-width:180px;flex:0 1 180px}
  .combo-art img{display:block;width:100%;height:auto;max-width:none}
  .combo-detail-cards .card-image-button img{width:190px}
  .combo-note .card-image-button img{width:64px;height:92px}
  .power-state .card-image-button img{width:68px;height:98px}
  @media(max-width:700px){.combo-art{min-height:215px;height:215px;padding:12px;gap:10px}.combo-art .card-image-button{width:calc((100% - 10px)/2);flex-basis:calc((100% - 10px)/2)}.combo-detail-cards .card-image-button img{width:160px}}
  @media(max-width:450px){.combo-art{min-height:185px;height:185px;padding:10px;gap:8px}.combo-art .card-image-button{width:calc((100% - 8px)/2);flex-basis:calc((100% - 8px)/2)}.combo-detail-cards .card-image-button img{width:140px}}
</style>
<style is:global>
  .card-image-button{display:block;margin:0;padding:0;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer}
  .card-image-button:focus-visible{outline:3px solid var(--red);outline-offset:4px;border-radius:8px}
  .card-image-button img{display:block}
  .hero-art .card-image-button+ .card-image-button img{transform:translateY(35px) rotate(-7deg);box-shadow:10px 11px 0 var(--gold)}
  .text-card{display:grid;place-items:center;width:64px;height:92px;border:1px dashed var(--muted);border-radius:6px;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.08em}
  .art-selector{border:0;border-top:1px solid #d8d3c8;margin:18px 0 0;padding:14px 0 0}.art-selector legend{font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:var(--red)}.art-selector>div{display:flex;gap:9px;flex-wrap:wrap}.art-option{display:grid;gap:4px;width:64px;border:2px solid transparent;border-radius:8px;background:transparent;padding:3px;text-align:center;font:inherit;font-size:10px;cursor:pointer}.art-option[aria-pressed="true"]{border-color:var(--red);background:#fff0bf}.art-option:focus-visible{outline:3px solid var(--red);outline-offset:2px}.art-option img{width:54px;height:78px;object-fit:cover;border-radius:4px}
  .combo-detail-intro{padding:62px 0 30px;max-width:760px}.back-link{display:inline-block;margin-bottom:28px;font-weight:900;text-decoration:none}.combo-detail-intro h1{margin:10px 0 16px;font-size:clamp(42px,8vw,82px);line-height:.9;letter-spacing:-.07em}.combo-detail-section{margin-top:42px}.combo-detail-section>h2,.combo-panel h2{font-size:clamp(28px,4vw,44px);line-height:.95;margin:9px 0 18px;letter-spacing:-.05em}.combo-detail-cards{display:flex;gap:14px;flex-wrap:wrap}.combo-detail-cards .card-image-button img{width:150px;border:2px solid var(--line);border-radius:10px;box-shadow:6px 6px 0 var(--ink)}.combo-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.combo-panel{border:2px solid var(--line);border-radius:15px;background:var(--card);padding:18px}.combo-steps{margin:0;padding-left:24px}.combo-steps li{padding:11px 0;border-bottom:1px solid #d8d3c8}.combo-notes{display:grid;gap:10px}.combo-note{display:flex;gap:12px;align-items:center;border-top:1px solid #d8d3c8;padding:10px 0}.combo-note:first-child{border-top:0}.combo-note p{margin:0;font-size:13px}.combo-note .card-image-button img{width:54px;height:78px;object-fit:cover;border:1px solid var(--line);border-radius:6px}.power-state-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.power-state{display:flex;gap:12px;align-items:center;border:2px solid var(--line);border-radius:15px;background:#fff0bf;padding:12px}.power-state .card-image-button img{width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:6px}.power-state b,.power-state strong{display:block}.power-state b{font-size:13px}.power-state strong{color:var(--red);font-size:15px;line-height:1.15;margin-top:5px}.combo-link{color:inherit;text-decoration:none}.combo-link:focus-visible{outline:3px solid var(--red);outline-offset:4px}@media(max-width:700px){.combo-detail-grid{grid-template-columns:1fr}.power-state-grid{grid-template-columns:1fr 1fr}}@media(max-width:450px){.combo-detail-cards .card-image-button img{width:110px}.power-state-grid{grid-template-columns:1fr}}
</style>
