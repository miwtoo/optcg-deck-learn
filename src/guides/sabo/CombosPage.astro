---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import CardModal from '../../components/CardModal.astro';
import { saboCombos } from '../../data/combos';
import { saboThaiCombos } from '../../content/sabo/th';
import { saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboCardAlt, saboGuideBase } from './data';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const isThai = lang === 'th';
const base = `${import.meta.env.BASE_URL}${saboGuideBase(lang)}`;
const deck = localizedSaboDeck(lang);
const flexCards = localizedSaboFlexCards(lang);
const copy = isThai ? saboThaiCombos : {
  title: 'Elbaph Sabo Combos',
  index: { eyebrow: 'THREE EASY LINES', heading: 'Make the line.', byline: 'Check the cost.', lede: 'Use these short lines after you build your board. Check your DON!! before you start.', listLabel: 'Combo lines', openGuide: 'OPEN GUIDE', openGuideText: 'See cards, steps, and power states.', openDetail: 'Open detail', noticeHeading: 'Simple order.', noticeText: 'Find the big body. Go wide. Then use Luffy or your 5K bodies to close.' },
};
---
<GuideLayout title={copy.title} active="combos" lang={lang} navigation={saboNavigation(lang)}>
  <section class="combo-intro"><div class="eyebrow">{copy.index.eyebrow}</div><h1>{copy.index.heading}<br><em>{copy.index.byline}</em></h1><p class="lede">{copy.index.lede}</p></section>
  <section class="combo-grid" aria-label={copy.index.listLabel}>{saboCombos.map((combo)=><article class="combo-card"><div class="combo-art">{combo.cards.slice(0, 2).map((id)=><CardImageButton id={id} alt={saboCardAlt(id, lang)} lang={lang} />)}</div><div class="combo-copy"><div class="eyebrow">{combo.number}</div><h2>{isThai ? saboThaiCombos.bySlug[combo.slug as keyof typeof saboThaiCombos.bySlug].title : combo.title}</h2><p>{isThai ? saboThaiCombos.bySlug[combo.slug as keyof typeof saboThaiCombos.bySlug].summary : combo.summary}</p><div class="combo-step"><b>{copy.index.openGuide}</b>{copy.index.openGuideText}</div><a class="button combo-open" href={`${base}/combos/${combo.slug}/`}>{copy.index.openDetail}</a></div></article>)}</section>
  <div class="notice"><b>{copy.index.noticeHeading}</b> {copy.index.noticeText}</div>
  <CardModal deck={deck} extraCards={flexCards} lang={lang} />
 </GuideLayout>
