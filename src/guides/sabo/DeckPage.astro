---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import CardModal from '../../components/CardModal.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideSection from '../../components/GuideSection.astro';
import { saboDeckTotal, saboCardMetadataById } from '../../data/sabo';
import { saboGroups, saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboGroupIds, saboCardAlt, saboGuideBase } from './data';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const base = `${import.meta.env.BASE_URL}${saboGuideBase}`;
const mainDeckTotal = saboDeckTotal - 1;
const deck = localizedSaboDeck();
const flexCards = localizedSaboFlexCards();
const copy = {
  title: 'Elbaph Sabo · Tournament quick reference',
  hero: { eyebrow: 'RED / BLACK · ELBAPH', heading: 'Elbaph Sabo', byline: 'Tournament quick reference', lede: 'Build wide early. Turn on Elbaph effects from 6 DON!!. Close with Luffy and Chopper.', deckCount: (count: number) => `1 leader + ${count} cards`, leaderAlt: 'Sabo leader' },
  guideNotice: { heading: 'Use this sheet at the table.', text: 'Use card text for exact effects. Use these short rules for turn choices.' },
  simplePlan: { eyebrow: 'THE TOURNAMENT PLAN', heading: 'Go wide, then turn on 12+.', flow: ['Find starters', 'Build wide', 'Reach 12+', 'Protect swings', 'Finish'], items: [
    { ids: ['OP01-016', 'OP17-086', 'OP17-080'], title: '1 · Find starters', text: 'Red Nami finds Docking Six or a 2-cost starter. Black Nami is strongest with Docking Six and Usopp ready. Usopp sets up the trash.', tag: 'Plan' },
    { ids: ['OP17-082', 'OP17-080', 'OP17-087'], title: '2 · Build wide', text: 'Use Sanji to filter. Use Usopp as the main value and trash setup. Play small bodies before the 12+ turn.', tag: 'Plan' },
    { ids: ['OP17-089', 'OP17-119'], title: '3 · Turn on Elbaph', text: 'Saul is the low-cost 12+ enabler. Loki is the preferred 12+ body. From 6 DON!!, turn on the Elbaph effects.', tag: 'Card text' },
    { ids: ['OP15-088', 'OP17-093', 'OP17-084'], title: '4 · Recover and finish', text: 'Docking Six recovers the 2-cost card you need. Luffy attacks now and recovers another 2-cost card. Chopper gives the finish attack [Unblockable].', tag: 'Plan' },
  ] },
  flexCards: { eyebrow: 'TOURNAMENT NOTES', heading: 'Keep the engine intact.', lede: 'Use these cards for narrow game states. Keep Saul, Usopp, Docking Six, Loki, Luffy, Robin, and your counters.', tiers: [
    { name: 'Recovery choices', cards: [
      { id: 'OP17-082', title: 'Sanji · filter', text: 'Use Sanji early. Draw 2 and trash 2 to place recovery targets in the trash.', tag: 'Card text' },
      { id: 'OP17-095', title: 'Zoro · protection', text: 'Use Zoro when you need a 2K counter. Keep it on board when effect removal can matter.', tag: 'Card text' },
      { id: 'ST01-011', title: 'Brook · leader DON!!', text: 'Use Brook when Luffy recovers it. Put up to 2 rested DON!! on the leader or a Character.', tag: 'Card text' },
    ] },
    { name: 'Finish choices', cards: [
      { id: 'OP17-087', title: 'Robin · key trade', text: 'Use Robin on play when −3000 can make an opposing Character a good trade.', tag: 'Card text' },
      { id: 'OP17-083', title: 'Jinbe · defense', text: 'Use Jinbe when a 12+ body is live. Keep it ready as a 5K Blocker.', tag: 'Card text' },
      { id: 'OP17-084', title: 'Chopper · bypass', text: 'Use Chopper on the finish turn when a 12+ body is live. Give the attack [Unblockable].', tag: 'Card text' },
    ] },
    { name: 'Counter choices', cards: [
      { id: 'OP04-016', title: 'Bad Manners · +3000', text: 'Use this Counter when you must protect a Leader or Character. Trash 1 card from hand.', tag: 'Card text' },
      { id: 'OP14-096', title: 'Ground Death · +4000', text: 'Use the Counter when your trash has 10 or more cards. Its Main effect negates an opposing Character effect at cost 5 or less.', tag: 'Card text' },
      { id: 'OP17-096', title: 'I’m Luffy · +4000', text: 'Use this optional Counter only when a 12+ body is live.', tag: 'Flex option' },
    ] },
  ], firstPackage: { heading: 'Tournament rule.', text: 'Do not cut the core engine for a narrow plan.' }, swapExamples: { heading: 'Quick check.', text: 'Choose the rule for the opposing Leader, then keep your recovery plan.' } },
  cardOptions: { eyebrow: 'MATCHUP CHEAT SHEET', heading: 'Choose the rule first.', lede: 'Use the rule for the opposing Leader. Keep the same core engine.', actions: { keep: 'Rule', remove: 'Remove', add: 'Add' }, swaps: [
    { title: 'Mirror · go second', items: [{ action: 'keep', quantity: 1, id: 'OP17-089' }] },
    { title: 'Mihawk · go wide', items: [{ action: 'keep', quantity: 1, id: 'OP17-087' }] },
    { title: 'Xebec · many swings', items: [{ action: 'keep', quantity: 1, id: 'OP14-096' }] },
    { title: 'Kaido · attack face', items: [{ action: 'keep', quantity: 1, id: 'OP17-084' }] },
    { title: 'Ace · keep pressure', items: [{ action: 'keep', quantity: 1, id: 'OP17-087' }] },
    { title: 'Enel / Robin · protect', items: [{ action: 'keep', quantity: 1, id: 'OP17-083' }] },
  ], legend: [
    { id: 'OP17-089', role: 'Mirror', use: 'Go second. Build your board before the opponent plays a 12-cost Character.' },
    { id: 'OP17-087', role: 'Mihawk', use: 'Go wide. Use Robin to reduce the 6-cost Mihawk and make the trade.' },
    { id: 'OP14-096', role: 'Xebec', use: 'Go second and make many swings. Hold Ground Death for Captain John; its Main route only targets cost 5 or less.' },
    { id: 'OP17-084', role: 'Kaido', use: 'Go first and attack face. Use Chopper to bypass Blockers and keep a second 12+ plan.' },
    { id: 'OP17-087', role: 'Ace', use: 'Go second and go wide. Use Robin on Ace plus Luffy. Do not use a Loki KO to enable Newgate.' },
    { id: 'OP17-083', role: 'Enel / Robin', use: 'Against Enel, go first and attack with all bodies. Against Robin, go first, attack face, and keep Brook in the trash for Jinbe plus Ground Death defense.' },
  ] },
  exactList: { eyebrow: 'THE EXACT LIST', deckCount: (count: number) => `1 leader + ${count} cards`, counted: (count: number) => `✓ Counted: ${count}`, source: 'This list has the updated 50-card deck. Tap a card for its local text.' },
  export: { eyebrow: 'EGMAN EVENTS DECK BUILDER', heading: 'Copy the deck list.', copy: 'Copy list', copied: 'Copied', source: 'Copy this list and paste it into Egman Events Deck Builder.', status: 'Copied to your clipboard.' },
  pilotLink: { label: 'Open the Pilot guide →', text: 'See the hand keeps, curves, recovery choices, and finish plans.' },
  source: { eyebrow: 'WEBSITE SOURCE', text: 'Fan-made quick reference based on the supplied SABO RB OP17 English guide and official card text.' },
};
const groupByCardId = (card: { readonly id: string }) => saboGroupIds[card.id] ?? 'other';
---
<GuideLayout title="Introduction to the deck SABO RB" active="deck" lang={lang} navigation={saboNavigation(lang)}>
  <GuideHero eyebrow="INTRODUCTION TO THE DECK" heading="SABO RB" byline="Red / Black Elbaph" lede="Build a wide board. Turn on Elbaph effects from 6 DON!!. Finish with Luffy and Chopper." chips={['OP13-004 Sabo', 'OP17 build', copy.hero.deckCount(mainDeckTotal)]} cards={[{ id: 'OP13-004', alt: copy.hero.leaderAlt }, { id: 'OP17-089', alt: saboCardAlt('OP17-089', 'Jaguar.D.Saul') }]} lang={lang} />
  <GuideSection aria-labelledby="introduction-title"><div class="eyebrow">INTRODUCTION TO THE DECK</div><h2 id="introduction-title">Introduction to the deck</h2><p class="lede">Find your starters. Build wide. Reach 12+ DON!! before you close the game.</p><div class="deck-intro-note"><b>Table rule.</b> Use card text for exact effects. Use this guide for turn choices.</div></GuideSection>
  <GuideSection aria-labelledby="conclusion-title"><div class="eyebrow">THE CORE PLAN</div><h2 id="conclusion-title">Conclusion</h2><p class="lede">Keep Saul, Usopp, Docking Six, Loki, Luffy, Robin, and your Counters. Recover the 2-cost card you need. Use Chopper on the finish turn when a 12+ body is live.</p><a class="button" href={`${base}/matchups/`}>Open matchup chapters →</a></GuideSection>
  <GuideSection aria-labelledby="deck-tech-title"><div class="eyebrow">DECKLIST AND TECH OPTIONS</div><h2 id="deck-tech-title">Decklist and tech options</h2><div class="deck-subheading"><div class="eyebrow">DECKLIST</div><h3>Decklist 09/09</h3><span class="count">{copy.exactList.counted(mainDeckTotal)}</span></div><CardGrid deck={deck} metadataById={saboCardMetadataById} groups={saboGroups} groupBy={groupByCardId} lang={lang} /><p class="source">{copy.exactList.source}</p><div class="tech-options"><div class="eyebrow">TECH OPTIONS</div><h3>Tech options</h3><p>Use these cards for narrow game states. Keep the core engine intact.</p>{copy.flexCards.tiers.map((tier)=><div class="tech-tier"><div class="eyebrow">{tier.name}</div><div class="lanes">{tier.cards.map((card)=><article class="lane"><div class="guidance-art"><CardImageButton id={card.id} alt={saboCardAlt(card.id, card.title)} lang={lang} /></div><h4>{card.title} · {card.id}</h4><p>{card.text}</p></article>)}</div></div>)}</div></GuideSection>
  <CardModal deck={deck} extraCards={flexCards} metadataById={saboCardMetadataById} lang={lang} />
</GuideLayout>

<style>
  .matchup-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.matchup-card,.matchup-legend{border:2px solid var(--line);border-radius:15px;background:var(--card);padding:16px;box-shadow:6px 7px 0 var(--blue)}.matchup-card:nth-child(3n){box-shadow:6px 7px 0 var(--gold)}.matchup-card h3{margin:0 0 14px;font-size:18px;line-height:1.1}.swap-list{display:grid;gap:10px}.swap-item{position:relative;display:grid;grid-template-columns:auto minmax(52px,72px) minmax(0,1fr);gap:10px;align-items:center;min-width:0;min-height:62px}.swap-item :global(.card-image-button){width:72px;height:104px;max-width:100%;overflow:hidden}:global(.swap-item .card-image-button img){display:block;width:72px;max-width:100%;height:104px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.swap-item strong,.swap-item small{display:block}.swap-item strong{font-size:13px;line-height:1.15}.swap-item small,.legend-card span,.legend-card small{color:var(--muted);font-size:11px}.swap-action{align-self:start;margin-top:3px;border-radius:99px;background:#f8d8d1;color:var(--red);padding:3px 7px;font-size:10px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}.swap-action-add,.swap-action-keep,.swap-action-test{background:var(--green);color:var(--ink)}.swap-action-test{background:var(--gold)}.swap-arrow{position:absolute;left:13px;bottom:-12px;z-index:1;color:var(--red);font-size:18px;line-height:1}.matchup-legend{margin-top:20px;box-shadow:none}.legend-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:12px}.legend-card{display:flex;gap:9px;align-items:center;border-top:1px solid #d8d3c8;padding-top:10px;min-width:0}.legend-card :global(.card-image-button){flex:0 0 43px;width:43px;height:62px;overflow:hidden}.legend-card :global(.card-image-button img){display:block;width:43px;height:62px;object-fit:cover;border:1px solid var(--line);border-radius:4px}.legend-card strong,.legend-card span,.legend-card b,.legend-card small{display:block}.legend-card strong,.legend-card b{font-size:11px;line-height:1.15}.legend-card b{margin-top:4px;color:var(--red)}.legend-card small{margin-top:3px;line-height:1.25}@media(max-width:800px){.legend-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.matchup-grid{grid-template-columns:1fr}.legend-grid{grid-template-columns:1fr 1fr}.swap-item{grid-template-columns:auto 48px minmax(0,1fr)}.swap-item :global(.card-image-button){width:48px;height:69px}.swap-item :global(.card-image-button img){width:48px;height:69px}}@media(max-width:560px){.export-panel .countline{align-items:flex-start;gap:18px}.export-panel .copy-button{padding:8px 11px;white-space:nowrap}}@media(min-width:1400px){:global(.shell){max-width:1640px}.hero{grid-template-columns:minmax(0,1.1fr) minmax(440px,.9fr);gap:clamp(48px,6vw,110px);padding-left:clamp(0px,3vw,48px);padding-right:clamp(0px,3vw,48px)}.matchup-grid{grid-template-columns:repeat(3,minmax(0,1fr))}:global(.card-grid){grid-template-columns:repeat(6,minmax(0,1fr))}}
</style>
