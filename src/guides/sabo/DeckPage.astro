---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import CardModal from '../../components/CardModal.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import { saboDeck, saboDeckTotal, saboFlexCards, saboCardMetadataById } from '../../data/sabo';
import { saboThaiDeck } from '../../content/sabo/th';
import { saboGroups, saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboGroupIds, saboCardAlt, saboCardName, saboGuideBase } from './data';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const isThai = lang === 'th';
const base = `${import.meta.env.BASE_URL}${saboGuideBase(lang)}`;
const mainDeckTotal = saboDeckTotal - 1;
const deck = localizedSaboDeck(lang);
const flexCards = localizedSaboFlexCards(lang);
const copy = isThai ? saboThaiDeck : {
  title: 'Elbaph Sabo · Car D. Kaizoku',
  hero: { eyebrow: 'RED / BLACK · ELBAPH PACKAGE', heading: 'Elbaph Sabo', byline: 'Car D. Kaizoku', lede: 'Build a wide board. Reach 12+. Let small bodies attack like giants.', deckCount: (count: number) => `1 leader + ${count} cards`, leaderAlt: 'Sabo leader' },
  guideNotice: { heading: 'How to read this guide.', text: 'Card text explains an effect. Guide claim tells you what the supplied video says. Game note marks an action seen in the supplied game.' },
  simplePlan: { eyebrow: 'THE SIMPLE PLAN', heading: 'Find the big switch.', flow: ['Search', 'Build wide', '12+ cost', '6K swings', 'Luffy close'], items: [
    { ids: ['OP17-086', 'OP17-080', 'OP17-089'], title: '1 · Fix your hand', text: 'Nami, Usopp, and Saul find the cards you need.', tag: 'Guide claim' },
    { ids: ['OP17-080', 'OP17-083', 'OP17-087', 'OP17-095'], title: '2 · Go wide', text: 'Play small bodies. A 12+ Character gives the four small Elbaph bodies +3K. With Sabo’s leader effect active, they are 6K.', tag: 'Card text' },
    { ids: ['OP17-089', 'OP17-119'], title: '3 · Reach 12+', text: 'Saul or Loki turns on the 12+ threshold.', tag: 'Card text' },
    { ids: ['OP17-093', 'OP17-087', 'ST01-011'], title: '4 · Close', text: 'Play Luffy, then play or replay Robin. Luffy draws 1 and can replay a 2-cost body. Luffy gets Rush with a 12+ Character.', tag: 'Card text + guide line' },
  ] },
  flexCards: { eyebrow: 'TECH AND FLEX CARDS', heading: 'Change the answer, not the engine.', lede: 'A tech card is a special card for one game problem. A flex card is a swap for the matchup. Do not cut Saul, Usopp, Luffy, Robin, or the other core engine cards first.', tiers: [
    { name: 'Tier 1 · first choices', cards: [{ id: 'OP17-081', title: 'Gerd', text: 'Use Gerd as an alternate for the Franky slot. Trash a card from hand to return an 8-cost-or-less Character from trash. Gerd needs an Elbaph-type Leader. Sabo is not one.', tag: 'Guide claim + card text' }, { id: 'OP17-082', title: '2-cost Sanji', text: 'Draw 2, then trash 2. With a 12+ Character, Sanji gains +3K and is 6K.', tag: 'Guide claim + card text' }, { id: 'OP11-012', title: 'Franky', text: '[Your Turn] [Once Per Turn] When the opponent activates an Event, all your Characters gain +2K. Keep Franky when the opponent uses many Events.', tag: 'Guide claim + card text' }] },
    { name: 'Tier 2 · strong choices', cards: [{ id: 'EB04-007', title: '7-cost Zoro', text: 'Use this in the mirror or against Alabasta Sabo and Luffy. On Play, your Leader gains +2K until the end of the opponent’s next turn. Its Rush: Character line needs an opposing 8K body.', tag: 'Guide claim + card text' }, { id: 'OP17-098', title: 'Kong Gun', text: 'Kong Gun needs a 12+ Character, 6 rested DON!!, your board, and two valuable cost-6-or-less targets. It can KO up to two opposing Characters. It is also a 3K counter.', tag: 'Guide claim + card text' }, { id: 'OP17-096', title: '“I’m Luffy…” Event', text: 'This is a 4K counter when a 12+ Character is on the board. It is strong when the threshold is always live. Kong Gun is more useful when you need removal.', tag: 'Guide claim + card text' }] },
    { name: 'Tier 3 · narrow choices', cards: [{ id: 'OP15-092', title: 'Nightmare Luffy', text: 'This can make Sabo a larger Leader. It has a 1K counter. It needs 20 cards in trash for the Leader bonus. That is harder to reach here.', tag: 'Guide claim + card text' }, { id: 'OP15-094', title: 'Zoro blocker', text: 'Use this when removal protection matters more than another 6K attacker. It can replace itself to protect a Straw Hat Crew Character. It does not gain the 12+ power bonus.', tag: 'Guide claim + card text' }, { id: 'OP17-091', title: '2-cost Elbaph Brook', text: 'With a 12+ Character, Brook gains +3K and is 6K. On Play, the opponent trashes 1 card from their hand.', tag: 'Guide claim + card text' }, { id: 'ST21-003', title: 'Unblockable Sanji', text: 'Use this as an alternate for Chopper. On Play, choose your Straw Hat Crew Character with 6K or more. If it attacks this turn, the opponent cannot activate Blocker.', tag: 'Guide claim + card text' }] },
  ], firstPackage: { heading: 'First tournament package.', text: 'Try 2 Gerd + 2 2-cost Sanji as swaps. Do not add cards. Do not cut core engine cards first. This package adds recovery and hand fixing.' }, swapExamples: { heading: 'Swap examples.', text: 'Use Franky into Event-heavy decks. Use 7-cost Zoro in the mirror. Use Kong Gun with two valuable cost-6-or-less targets. Use “I’m Luffy…” as a conditional 4K counter. Bad Manners stays a base-list counter. It is not a ranked flex choice.' } },
  cardOptions: { eyebrow: 'CARD OPTIONS', heading: 'Make a clear swap.', lede: 'Choose one card option. Keep the rest of the list.', actions: { keep: 'Keep', remove: 'Remove', add: 'Add' }, swaps: [{ title: 'Event-heavy decks', items: [{ action: 'keep', quantity: 2, id: 'OP11-012' }] }, { title: 'Mirror option', items: [{ action: 'remove', quantity: 2, id: 'OP11-012' }, { action: 'add', quantity: 2, id: 'EB04-007' }] }, { title: 'Franky slot alternate', items: [{ action: 'remove', quantity: 2, id: 'OP11-012' }, { action: 'add', quantity: 2, id: 'OP17-081' }] }, { title: 'Jinbe slot alternate', items: [{ action: 'remove', quantity: 2, id: 'OP17-083' }, { action: 'add', quantity: 2, id: 'OP15-094' }] }, { title: 'Chopper slot alternate', items: [{ action: 'remove', quantity: 2, id: 'OP17-084' }, { action: 'add', quantity: 2, id: 'ST21-003' }] }, { title: 'Optional counter', items: [{ action: 'add', quantity: 2, id: 'OP17-096' }] }], legend: [{ id: 'OP11-012', name: 'Franky', role: 'Event payoff', use: 'Use against Event-heavy decks.' }, { id: 'OP17-081', name: 'Gerd', role: 'Franky alternate', use: 'Use as an alternate for the Franky slot.' }, { id: 'OP17-084', name: 'Tony Tony.Chopper', role: 'Unblockable line', use: 'Use with a 12+ Character in play.' }, { id: 'EB04-007', name: 'Roronoa Zoro', role: 'Mirror choice', use: 'Use for the Sabo / Black Luffy mirror.' }, { id: 'OP17-083', name: 'Jinbe', role: 'Blocker', use: 'Use as the base blocker choice.' }, { id: 'OP15-094', name: 'Roronoa Zoro', role: 'Jinbe alternate', use: 'Use as an alternate blocker for Jinbe.' }, { id: 'ST21-003', name: 'Sanji', role: 'Chopper alternate', use: 'Use with a 6K or stronger Straw Hat Crew Character.' }, { id: 'OP17-096', name: 'I’m Luffy!! The Man Who Will Be King of the Pirates!!', role: 'Conditional 4K counter', use: 'Use when a 12+ Character is in play.' }] },
  exactList: { eyebrow: 'THE EXACT LIST', deckCount: (count: number) => `1 leader + ${count} cards`, counted: (count: number) => `✓ Counted: ${count}`, source: 'This sheet uses every card and quantity from the supplied deck list. Tap a card for its local text.' }, export: { eyebrow: 'EGMAN EVENTS DECK BUILDER', heading: 'Copy the deck list.', copy: 'Copy list', copied: 'Copied', source: 'Copy this list and paste it into Egman Events Deck Builder.', status: 'Copied to your clipboard.' }, pilotLink: { label: 'Open the Pilot guide →', text: 'Learn the turn order, hand keeps, and DON!! curve.' }, source: { eyebrow: 'WEBSITE SOURCE', text: 'Fan-made learning guide based on Car D. Kaizoku’s Elbaph Sabo guide. Simplified and adapted for beginner practice.' },
};
const egmanExport = [...saboDeck, { id: 'Other Cards:', name: '', quantity: '' }, ...saboFlexCards.map((card) => ({ ...card, quantity: 2 }))].map((card) => card.id === 'Other Cards:' ? card.id : `${card.quantity} ${card.id} ${card.name}`).join('\n');
const matchupNames = (id: string, fallback: string) => saboCardName(id, lang, fallback);
const localizedSwaps = copy.cardOptions.swaps.map((swap) => ({ ...swap, items: swap.items.map((item) => ({ ...item, action: item.action.toLowerCase(), name: matchupNames(item.id, item.id) })) }));
const localizedLegend = copy.cardOptions.legend.map((card) => ({ ...card, name: matchupNames(card.id, 'name' in card ? card.name : card.id) }));
const actionLabel = (action: string) => copy.cardOptions.actions[action as keyof typeof copy.cardOptions.actions] ?? action;
const groupByCardId = (card: { readonly id: string }) => saboGroupIds[card.id] ?? 'other';
---
<GuideLayout title={copy.title} active="deck" lang={lang} navigation={saboNavigation(lang)}>
   <section class="hero"><div><div class="eyebrow">{copy.hero.eyebrow}</div><h1>{copy.hero.heading}<br><em>{copy.hero.byline}</em></h1><p class="lede">{copy.hero.lede}</p><div class="chips"><span class="chip">OP13-004 Sabo</span><span class="chip">OP17 build</span><span class="chip">{copy.hero.deckCount(mainDeckTotal)}</span></div></div><div class="hero-art"><CardImageButton id="OP13-004" alt={copy.hero.leaderAlt} lang={lang} /><CardImageButton id="OP17-089" alt={saboCardAlt('OP17-089', lang, 'Jaguar.D.Saul')} lang={lang} /></div></section>
    <div class="notice"><b>{copy.guideNotice.heading}</b> {copy.guideNotice.text}</div>
    <section class="section"><div class="eyebrow">{copy.simplePlan.eyebrow}</div><h2>{copy.simplePlan.heading}</h2><div class="overview">{copy.simplePlan.items.map((item)=><article class="tile"><div class="guidance-art">{item.ids.map((id)=><CardImageButton id={id} alt={saboCardAlt(id, lang)} lang={lang} />)}</div><h3>{item.title}</h3><p>{item.text} <span class="tag">{item.tag}</span></p></article>)}</div></section>
    <section class="section"><div class="flow">{copy.simplePlan.flow.map((item, index)=><>{index > 0 && <b>→</b>}<span>{item}</span></>)}</div></section>
      <section class="section"><div class="eyebrow">{copy.flexCards.eyebrow}</div><h2>{copy.flexCards.heading}</h2><p class="lede" style="font-size:16px">{copy.flexCards.lede}</p>{copy.flexCards.tiers.map((tier)=><div class="section" style="margin-top:28px"><div class="eyebrow">{tier.name}</div><div class="lanes">{tier.cards.map((card)=><article class="lane"><div class="guidance-art"><CardImageButton id={card.id} alt={saboCardAlt(card.id, lang, card.title)} lang={lang} /></div><h3>{card.title} · {card.id}</h3><p>{card.text} <span class="tag">{card.tag}</span></p></article>)}</div></div>)}<div class="notice"><b>{copy.flexCards.firstPackage.heading}</b><p>{copy.flexCards.firstPackage.text}</p><p><b>{copy.flexCards.swapExamples.heading}</b> {copy.flexCards.swapExamples.text}</p></div></section>
     <section class="section matchup-section"><div class="eyebrow">{copy.cardOptions.eyebrow}</div><h2>{copy.cardOptions.heading}</h2><p class="lede" style="font-size:16px">{copy.cardOptions.lede}</p><div class="matchup-grid">{localizedSwaps.map((swap)=><article class="matchup-card"><h3>{swap.title}</h3><div class="swap-list">{swap.items.map((item, index)=><div class="swap-item"><span class:list={{ 'swap-action': true, 'swap-action-add': item.action === 'add', 'swap-action-keep': item.action === 'keep', 'swap-action-test': item.action === 'test' }}>{actionLabel(item.action)}</span><CardImageButton id={item.id} alt={saboCardAlt(item.id, lang, item.name)} lang={lang} /><div><strong>{item.quantity} {item.name}</strong><small>{item.id}</small></div>{index < swap.items.length - 1 && <span class="swap-arrow" aria-hidden="true">→</span>}</div>)}</div></article>)}</div><div class="matchup-legend"><div class="eyebrow">{isThai ? 'คำอธิบายการ์ด' : 'CARD LEGEND'}</div><div class="legend-grid">{localizedLegend.map((card)=><article class="legend-card"><CardImageButton id={card.id} alt={saboCardAlt(card.id, lang, card.name)} lang={lang} /><div><strong>{card.name}</strong><span>{card.id}</span><b>{card.role}</b><small>{card.use}</small></div></article>)}</div></div></section>
     <section class="section"><div class="countline"><div><div class="eyebrow">{copy.exactList.eyebrow}</div><h2>{copy.exactList.deckCount(mainDeckTotal)}</h2></div><div class="count">{copy.exactList.counted(mainDeckTotal)}</div></div><CardGrid deck={deck} metadataById={saboCardMetadataById} groups={saboGroups(lang)} groupBy={groupByCardId} lang={lang} /><p class="source">{copy.exactList.source}</p></section>
     <section class="section export-panel"><div class="countline"><div><div class="eyebrow">{copy.export.eyebrow}</div><h2>{copy.export.heading}</h2></div><button class="button copy-button" type="button" data-copy-export data-copy-label={copy.export.copy} data-copied-label={copy.export.copied}>{copy.export.copy}</button></div><p class="source">{copy.export.source}</p><pre class="deck-export" data-deck-export>{egmanExport}</pre><p class="copy-status" data-copy-status data-copied-status={copy.export.status} role="status" aria-live="polite"></p></section>
    <div class="notice"><a class="button" href={`${base}/pilot/`}>{copy.pilotLink.label}</a><p>{copy.pilotLink.text}</p></div>
    <section class="section"><div class="eyebrow">{copy.source.eyebrow}</div><p>{copy.source.text}</p><p><a href="https://youtu.be/pW0WQAHiZyk?si=_8f0yDqn1B07T95X">https://youtu.be/pW0WQAHiZyk?si=_8f0yDqn1B07T95X</a></p></section>
    <CardModal deck={deck} extraCards={flexCards} metadataById={saboCardMetadataById} lang={lang} />
 </GuideLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-export]');
  const exportBlock = document.querySelector<HTMLElement>('[data-deck-export]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  copyButton?.addEventListener('click', async () => {
    if (!exportBlock || !copyStatus) return;
    await navigator.clipboard.writeText(exportBlock.textContent ?? '');
    copyButton.textContent = copyButton.dataset.copiedLabel ?? 'Copied';
    copyStatus.textContent = copyStatus.dataset.copiedStatus ?? 'Copied to your clipboard.';
    window.setTimeout(() => { copyButton.textContent = copyButton.dataset.copyLabel ?? 'Copy list'; copyStatus.textContent = ''; }, 2200);
  });
</script>

<style>
  .export-panel{position:relative}.copy-button{font:inherit;cursor:pointer}.copy-button:focus-visible{outline:3px solid var(--red);outline-offset:3px}.deck-export{overflow:auto;margin:0;padding:18px;border:2px solid var(--line);border-radius:14px;background:var(--ink);color:#fffdf7;font:13px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.copy-status{min-height:1.5em;margin:8px 0 0;color:var(--red);font-weight:900}.matchup-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.matchup-card,.matchup-legend{border:2px solid var(--line);border-radius:15px;background:var(--card);padding:16px;box-shadow:6px 7px 0 var(--blue)}.matchup-card:nth-child(3n){box-shadow:6px 7px 0 var(--gold)}.matchup-card h3{margin:0 0 14px;font-size:18px;line-height:1.1}.swap-list{display:grid;gap:10px}.swap-item{position:relative;display:grid;grid-template-columns:auto minmax(52px,72px) minmax(0,1fr);gap:10px;align-items:center;min-width:0;min-height:62px}.swap-item :global(.card-image-button){width:72px;height:104px;max-width:100%;overflow:hidden}:global(.swap-item .card-image-button img){display:block;width:72px;max-width:100%;height:104px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.swap-item strong,.swap-item small{display:block}.swap-item strong{font-size:13px;line-height:1.15}.swap-item small,.legend-card span,.legend-card small{color:var(--muted);font-size:11px}.swap-action{align-self:start;margin-top:3px;border-radius:99px;background:#f8d8d1;color:var(--red);padding:3px 7px;font-size:10px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}.swap-action-add,.swap-action-keep,.swap-action-test{background:var(--green);color:var(--ink)}.swap-action-test{background:var(--gold)}.swap-arrow{position:absolute;left:13px;bottom:-12px;z-index:1;color:var(--red);font-size:18px;line-height:1}.matchup-legend{margin-top:20px;box-shadow:none}.legend-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:12px}.legend-card{display:flex;gap:9px;align-items:center;border-top:1px solid #d8d3c8;padding-top:10px;min-width:0}.legend-card :global(.card-image-button){flex:0 0 43px;width:43px;height:62px;overflow:hidden}.legend-card :global(.card-image-button img){display:block;width:43px;height:62px;object-fit:cover;border:1px solid var(--line);border-radius:4px}.legend-card strong,.legend-card span,.legend-card b,.legend-card small{display:block}.legend-card strong,.legend-card b{font-size:11px;line-height:1.15}.legend-card b{margin-top:4px;color:var(--red)}.legend-card small{margin-top:3px;line-height:1.25}@media(max-width:800px){.legend-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.matchup-grid{grid-template-columns:1fr}.legend-grid{grid-template-columns:1fr 1fr}.swap-item{grid-template-columns:auto 48px minmax(0,1fr)}.swap-item :global(.card-image-button){width:48px;height:69px}.swap-item :global(.card-image-button img){width:48px;height:69px}}@media(max-width:560px){.export-panel .countline{align-items:flex-start;gap:18px}.export-panel .copy-button{padding:8px 11px;white-space:nowrap}}@media(min-width:1400px){:global(.shell){max-width:1640px}.hero{grid-template-columns:minmax(0,1.1fr) minmax(440px,.9fr);gap:clamp(48px,6vw,110px);padding-left:clamp(0px,3vw,48px);padding-right:clamp(0px,3vw,48px)}.matchup-grid{grid-template-columns:repeat(3,minmax(0,1fr))}:global(.card-grid){grid-template-columns:repeat(6,minmax(0,1fr))}}
</style>
