---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import CardModal from '../../components/CardModal.astro';
import { saboCombos } from '../../data/combos';
import { saboThaiCombos } from '../../content/sabo/th';
import { saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboCardAlt, saboGuideBase } from './data';
import type { Locale } from '../../i18n/ui';

const { slug, lang = 'en' } = Astro.props as { slug?: string; lang?: Locale };
const combo = saboCombos.find((item) => item.slug === slug);
if (!combo) throw new Error(`Unknown Sabo combo: ${slug}`);
const thaiCombo = slug && saboThaiCombos.bySlug[slug as keyof typeof saboThaiCombos.bySlug];
const localizedCombo = lang === 'th' && thaiCombo ? { ...combo, ...thaiCombo } : combo;
const base = `${import.meta.env.BASE_URL}${saboGuideBase(lang)}`;
const deck = localizedSaboDeck(lang);
const flexCards = localizedSaboFlexCards(lang);
const detailCopy = lang === 'th' ? saboThaiCombos.detail : { allCombos: '← All combos', cardsUsed: 'CARDS USED', howToPlay: 'HOW TO PLAY', followSteps: 'Follow these steps.', prerequisites: 'PREREQUISITES', checkBefore: 'Check before you start.', result: 'RESULT', resultHeading: 'What the line gives you.', powerStates: 'POWER STATES', powerStatesHeading: 'See the change.' };
const cardAlt = (id: string) => saboCardAlt(id, lang);
const prerequisiteNotes = localizedCombo.prerequisites.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text }));
const resultNotes = localizedCombo.result.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text }));
---
<GuideLayout title={`Elbaph Sabo · ${localizedCombo.title}`} active="combos" lang={lang} navigation={saboNavigation(lang)}>
  <section class="combo-detail-intro"><a class="back-link" href={`${base}/combos/`}>{detailCopy.allCombos}</a><div class="eyebrow">{localizedCombo.number}</div><h1>{localizedCombo.title}</h1><p class="lede">{localizedCombo.summary}</p></section>
  <section class="combo-detail-section"><div class="eyebrow">{detailCopy.cardsUsed}</div><div class="combo-detail-cards">{localizedCombo.cards.map((id) => <CardImageButton id={id} alt={cardAlt(id)} lang={lang} />)}</div></section>
  <section class="combo-detail-section combo-detail-grid"><article class="combo-panel"><div class="eyebrow">{detailCopy.howToPlay}</div><h2>{detailCopy.followSteps}</h2><ol class="combo-steps">{localizedCombo.steps.map((step) => <li>{step}</li>)}</ol></article><article class="combo-panel"><div class="eyebrow">{detailCopy.prerequisites}</div><h2>{detailCopy.checkBefore}</h2><div class="combo-notes">{prerequisiteNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={cardAlt(note.cardId)} lang={lang} />}<p>{note.text}</p></div>)}</div></article></section>
  <section class="combo-detail-section"><div class="eyebrow">{detailCopy.result}</div><h2>{detailCopy.resultHeading}</h2><div class="combo-notes combo-result">{resultNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={cardAlt(note.cardId)} lang={lang} />}<p>{note.text}</p></div>)}</div></section>
  <section class="combo-detail-section"><div class="eyebrow">{detailCopy.powerStates}</div><h2>{detailCopy.powerStatesHeading}</h2><div class="power-state-grid">{localizedCombo.powerStates.map((state) => <article class="power-state"><CardImageButton id={state.cardId} alt={cardAlt(state.cardId)} lang={lang} /><div><b>{state.label}</b><strong>{state.value}</strong></div></article>)}</div></section>
  <CardModal deck={deck} extraCards={flexCards} lang={lang} />
 </GuideLayout>
