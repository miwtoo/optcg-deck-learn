---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import CardModal from '../../components/CardModal.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideSection from '../../components/GuideSection.astro';
import GuideJumpLinks from '../../components/GuideJumpLinks.astro';
import CardCluster from '../../components/CardCluster.astro';
import { saboCardMetadataById } from '../../data/sabo';
import { saboCombos } from '../../data/combos';
import { saboThaiPilot } from '../../content/sabo/th';
import { saboThaiCombos } from '../../content/sabo/th';
import { saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboCardAlt } from './data';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const isThai = lang === 'th';
const deck = localizedSaboDeck(lang);
const flexCards = localizedSaboFlexCards(lang);
const copy = isThai ? saboThaiPilot : {
  title: 'Elbaph Sabo Pilot',
  hero: { eyebrow: 'PILOT GUIDE · RED / BLACK ELBAPH', heading: 'Play Sabo', byline: 'one step at a time.', lede: 'Find the pieces. Build wide. Reach 12+. Then swing hard.' },
  startingHand: { eyebrow: 'STARTING HAND', heading: 'Keep the path, not just the shiny card.', tag: 'Video claim', items: [{ ids: ['OP17-080', 'OP17-089'], title: 'First keep · Usopp / Saul', text: 'They find the next piece. Saul also becomes a 12+ body.' }, { ids: ['OP17-095'], title: 'Then keep · Zoro', text: 'Zoro is a 2K counter. With a 12+ Character in play and Sabo’s leader effect active, Zoro is a 6K attacker.' }, { ids: ['OP15-088', 'OP17-119', 'OP17-093'], title: 'Payoff · Docking Six / Loki / Luffy', text: 'Keep one when your hand already has a plan.' }, { ids: ['OP17-087'], title: 'Maybe keep · Robin', text: 'Keep her when −3K makes a good attack.' }] },
  model: { eyebrow: 'PILOT MODEL', heading: 'Small steps. Big board.', reminderHeading: 'Remember three numbers.', reminder: 'With 4 or more Life, Sabo is 4K. With 1 DON!! and your own 8+ Character, Sabo and your Characters get +1K. Any 12+ Character gives the four small Elbaph bodies +3K. With Sabo’s leader effect active, they are 6K. Play Luffy, then play or replay Robin. Do not wait for Robin before you play Luffy.', tag: 'Card text + guide line', stepsEyebrow: 'BEGINNER PILOT · DO THIS IN ORDER', stepTag: 'Simple guide', steps: [{ title: 'Mulligan', ids: ['OP17-080', 'OP17-089'], text: 'Keep Usopp or Saul first. Keep Zoro next. Keep payoff cards only with a way to reach 12+.' }, { title: 'Choose your road', ids: ['OP17-086', 'OP17-080'], text: 'First: plan Nami, then Usopp, then Saul or Docking Six. Second: plan Nami or Usopp, then Saul or two small bodies.' }, { title: 'Early turns · find pieces', ids: ['OP17-086', 'OP01-016', 'OP17-080', 'OP17-089'], text: 'First: play either Nami at 1 DON!!, then Usopp at 3. Second: play Nami or Usopp at 2. Fix the hand before you build.' }, { title: 'Middle turns · build', ids: ['OP17-089', 'OP15-088', 'OP17-083'], text: 'First: play Saul at 5, or Docking Six. Second: play Saul at 4, or Usopp plus another 2-cost.' }, { title: 'Turn on thresholds', ids: ['OP17-089', 'OP17-119', 'OP17-093'], text: 'Saul or Loki counts as 12+. The four small Elbaph bodies gain +3K. With Sabo’s leader effect active, they are 6K. Keep 1 DON!! for Sabo when an 8+ Character is live.' }, { title: 'Attack safely', ids: ['OP17-087', 'OP17-095'], text: 'Use Robin −3K first, then swing with your 6K bodies. Keep Jinbe ready when you need a blocker.' }, { title: 'Close the turn', ids: ['OP17-093', 'ST01-011', 'OP17-098'], text: 'Play Luffy, then play or replay Robin. If a 12+ Character is in play, Luffy gets Rush. Brook can put two rested DON!! on Sabo. Keep counters when the board needs safety.' }] },
  replayTargets: { eyebrow: 'LUFFY · OP17-093', heading: 'OP17-093 Luffy replay targets', onPlay: 'On Play:', text: 'Draw 1 card. You can play 1 Character card with a cost of 2 or less from your trash. If a 12+ cost Character is in play, Luffy gets Rush.', note: 'These are the valid replay targets in this deck.', ids: ['OP01-016', 'ST01-011', 'OP17-084', 'OP17-086', 'OP17-080', 'OP17-083', 'OP17-087', 'OP17-095'] },
  searchPriority: { eyebrow: 'SEARCH · USE THE BOARD STATE', heading: 'Search priority by need', note: 'Use these as situational choices. Your hand and board state can change the choice.', items: [{ need: 'Need a setup card', id: 'OP17-086', name: 'Nami', text: 'Use OP17-086 Nami when you need to fix your hand. OP17-080 Usopp is another option when you need to search the top three cards.' }, { need: 'Need board control', id: 'OP17-087', name: 'Nico Robin', text: 'Use Nico Robin when her −3000 effect can lower an opposing Character.' }, { need: 'Need protection', id: 'OP17-083', name: 'Jinbe', text: 'Use Jinbe when a blocker can protect your board.' }, { need: 'Need a 2K counter', id: 'OP17-095', name: 'Roronoa Zoro', text: 'Use Zoro when you need a 2K counter in your hand.' }, { need: 'Need DON!! support', id: 'ST01-011', name: 'Brook', text: 'Use Brook when two rested DON!! cards can help your Leader or a Character.' }, { need: 'Need an unblockable attack', id: 'OP17-084', name: 'Tony Tony.Chopper', text: 'Use Chopper when a 12+ cost Character is in play and you need an unblockable attack.' }] },
  curve: { eyebrow: 'IDEAL DON!! CURVE', heading: 'Spend DON!! in this order.', note: 'This is a sample menu, not a rule. Keep counters when the board needs safety.', tag: 'Card text + strong inference', lanes: [{ heading: 'Going first', turns: [{ title: 'Turn 1 · 1 DON!!', ids: ['OP17-086', 'OP01-016'], separators: ['OR'], text: 'Play either Nami. Use the effect to fix your hand.' }, { title: 'Turn 2 · 3 DON!!', ids: ['OP17-080'], separators: [], text: 'Play Usopp and search three.' }, { title: 'Turn 3 · 5 DON!!', ids: ['OP17-089', 'OP15-088'], separators: ['OR'], text: 'Play Saul, or use Docking Six to widen.' }, { title: 'Turn 4 · 7 DON!!', ids: ['OP17-119', 'OP15-088'], separators: ['OR'], text: 'Play Loki, or Docking Six into a helper.' }, { title: 'Turn 5 · 9 DON!!', ids: ['OP17-093', 'OP17-087'], separators: ['+'], text: 'Play Luffy, then play or replay Robin. If a 12+ Character is in play, Luffy gets Rush.' }] }, { heading: 'Going second', turns: [{ title: 'Turn 1 · 2 DON!!', ids: ['OP17-086', 'OP17-080'], separators: ['OR'], text: 'Play Nami or Usopp to fix the hand.' }, { title: 'Turn 2 · 4 DON!!', ids: ['OP17-089', 'OP17-080'], separators: ['OR'], text: 'Play Saul, or two 2-cost bodies.' }, { title: 'Turn 3 · 6 DON!!', ids: ['OP17-089', 'OP17-119', 'OP15-088'], separators: ['OR', 'OR'], text: 'Play Saul, Loki, or Docking Six.' }, { title: 'Turn 4 · 8 DON!!', ids: ['OP17-093', 'ST01-011'], separators: ['+'], text: 'Play Luffy and replay Brook or another helper.' }, { title: 'Turn 5 · 10 DON!!', ids: ['OP17-093', 'OP17-087', 'OP17-098'], separators: ['OR', 'OR'], text: 'Use Luffy, or Kong Gun with a 12+ Character, 6 rested DON!!, your board, and two valuable cost-6-or-less targets.' }] }] },
};
const keep = copy.startingHand.items;
const steps = copy.model.steps;
const curves = copy.curve.lanes;
const searchNeeds = copy.searchPriority.items.map((item) => ({ need: item.need, id: item.id, text: item.text, name: 'name' in item ? item.name : saboCardAlt(item.id, lang).replace(`การ์ด ${item.id} `, '') }));
const comboCopy = isThai ? saboThaiCombos : {
  index: { eyebrow: 'THREE EASY LINES', heading: 'Make the line.', byline: 'Check the cost.', lede: 'Use these short lines after you build your board. Check your DON!! before you start.', listLabel: 'Combo lines', openGuide: 'OPEN GUIDE', openGuideText: 'See cards, steps, and power states.', noticeHeading: 'Simple order.', noticeText: 'Find the big body. Go wide. Then use Luffy or your 5K bodies to close.' },
  detail: { cardsUsed: 'CARDS USED', howToPlay: 'HOW TO PLAY', followSteps: 'Follow these steps.', prerequisites: 'PREREQUISITES', checkBefore: 'Check before you start.', result: 'RESULT', resultHeading: 'What the line gives you.', powerStates: 'POWER STATES', powerStatesHeading: 'See the change.' },
};
const comboDetails = saboCombos.map((combo) => {
  const thai = saboThaiCombos.bySlug[combo.slug as keyof typeof saboThaiCombos.bySlug];
  return lang === 'th' && thai ? { ...combo, ...thai } : combo;
});
---
<GuideLayout title={copy.title} active="pilot" lang={lang} navigation={saboNavigation(lang)}>
  <GuideHero eyebrow={copy.hero.eyebrow} heading={copy.hero.heading} byline={copy.hero.byline} lede={copy.hero.lede} cards={[{ id: 'OP13-004', alt: saboCardAlt('OP13-004', lang, 'Sabo leader') }, { id: 'OP17-089', alt: saboCardAlt('OP17-089', lang, 'Jaguar.D.Saul') }]} lang={lang} />
  <GuideJumpLinks ariaLabel={isThai ? 'หัวข้อในคู่มือ' : 'Guide sections'} links={isThai ? [{ href: '#starting-hand', label: 'มือเริ่มต้น' }, { href: '#turn-plan', label: 'แผนเทิร์น' }, { href: '#combos', label: 'คอมโบ' }] : [{ href: '#starting-hand', label: 'Starting hand' }, { href: '#turn-plan', label: 'Turn plan' }, { href: '#combos', label: 'Combos' }]} />
  <GuideSection id="starting-hand"><div class="eyebrow">{copy.startingHand.eyebrow}</div><h2>{copy.startingHand.heading}</h2><div class="overview">{keep.map((item)=><article class="keep"><CardCluster ids={item.ids} alt={(id) => saboCardAlt(id, lang)} wrapperClass="guidance-art" lang={lang} /><h3>{item.title}</h3><p>{item.text} <span class="tag">{copy.startingHand.tag}</span></p></article>)}</div></GuideSection>
   <GuideSection id="turn-plan"><div class="eyebrow">{copy.model.eyebrow}</div><h2>{copy.model.heading}</h2><div class="notice"><CardCluster ids={['OP13-004','OP17-089','OP17-119','OP17-093']} alt={(id) => saboCardAlt(id, lang)} wrapperClass="threshold-art" lang={lang} /><b>{copy.model.reminderHeading}</b><p>{copy.model.reminder} <span class="tag">{copy.model.tag}</span></p></div><div class="eyebrow">{copy.model.stepsEyebrow}</div><div class="pilot-flow">{steps.map((step,index)=><article class="pilot-step"><div class="step-no">{index}</div><div><CardCluster ids={step.ids} alt={(id) => saboCardAlt(id, lang)} wrapperClass="guidance-art" lang={lang} /><h3>{step.title}</h3><p>{step.text}</p><span class="tag">{copy.model.stepTag}</span></div></article>)}</div></GuideSection>
   <GuideSection class="section visual-guide" aria-labelledby="replay-targets-title"><div class="eyebrow">{copy.replayTargets.eyebrow}</div><h2 id="replay-targets-title">{copy.replayTargets.heading}</h2><div class="guide-callout"><div class="guide-callout-art"><CardImageButton id="OP17-093" alt={saboCardAlt('OP17-093', lang, 'OP17-093 Monkey.D.Luffy')} lang={lang} /></div><p><strong>{copy.replayTargets.onPlay}</strong> {copy.replayTargets.text}</p></div><p class="guide-note">{copy.replayTargets.note}</p><div class="target-grid">{copy.replayTargets.ids.map((id) => { const card = saboCardMetadataById[id]; return <article class="target-card"><CardImageButton id={id} alt={saboCardAlt(id, lang, `${id} ${card.name}`)} lang={lang} /><div><strong>{id}</strong><span>{lang === 'th' ? saboCardAlt(id, lang).replace(`การ์ด ${id} `, '') : card.name}</span></div></article>; })}</div></GuideSection>
   <GuideSection class="section visual-guide" aria-labelledby="search-priority-title"><div class="eyebrow">{copy.searchPriority.eyebrow}</div><h2 id="search-priority-title">{copy.searchPriority.heading}</h2><p class="guide-note">{copy.searchPriority.note}</p><div class="need-list">{searchNeeds.map((item)=><article class="need-card"><div class="need-card-art"><CardImageButton id={item.id} alt={saboCardAlt(item.id, lang, `${item.id} ${item.name ?? ''}`)} lang={lang} /></div><div><strong>{item.need}</strong><h3>{item.name ?? ''}</h3><p>{item.text}</p></div></article>)}</div></GuideSection>
   <GuideSection><div class="eyebrow">{copy.curve.eyebrow}</div><h2>{copy.curve.heading}</h2><p class="source">{copy.curve.note}</p><div class="ideal-curve">{curves.map((lane)=><article class="ideal-lane"><h3>{lane.heading}</h3>{lane.turns.map((turn)=><div class="ideal-step"><CardCluster ids={turn.ids} separators={turn.separators as ('OR' | '+')[]} alt={(id) => saboCardAlt(id, lang)} wrapperClass="ideal-pair" lang={lang} /><div><h4>{turn.title}</h4><p>{turn.text}</p><span class="tag">{copy.curve.tag}</span></div></div>)}</article>)}</div></GuideSection>
     <GuideSection id="combos" class="section visual-guide" aria-labelledby="combo-lines-title"><div class="eyebrow">{comboCopy.index.eyebrow}</div><h2 id="combo-lines-title">{comboCopy.index.heading}<br /><em>{comboCopy.index.byline}</em></h2><p class="lede">{comboCopy.index.lede}</p><div class="combo-grid" aria-label={comboCopy.index.listLabel}>{comboDetails.map((combo) => <article class="combo-card"><div class="combo-art">{combo.cards.slice(0, 2).map((id) => <CardImageButton id={id} alt={saboCardAlt(id, lang)} lang={lang} />)}</div><div class="combo-copy"><div class="eyebrow">{combo.number}</div><h3>{combo.title}</h3><p>{combo.summary}</p><div class="combo-step"><b>{comboCopy.index.openGuide}</b>{comboCopy.index.openGuideText}</div></div></article>)}</div><div class="notice"><b>{comboCopy.index.noticeHeading}</b> {comboCopy.index.noticeText}</div></GuideSection>
    {comboDetails.map((combo) => { const prerequisiteNotes = combo.prerequisites.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text })); const resultNotes = combo.result.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text })); return <GuideSection class="combo-detail-section" aria-labelledby={`combo-${combo.slug}-title`}><div class="eyebrow">{combo.number}</div><h2 id={`combo-${combo.slug}-title`}>{combo.title}</h2><p class="lede">{combo.summary}</p><div class="eyebrow">{comboCopy.detail.cardsUsed}</div><div class="combo-detail-cards">{combo.cards.map((id) => <CardImageButton id={id} alt={saboCardAlt(id, lang)} lang={lang} />)}</div><div class="combo-detail-grid"><article class="combo-panel"><div class="eyebrow">{comboCopy.detail.howToPlay}</div><h2>{comboCopy.detail.followSteps}</h2><ol class="combo-steps">{combo.steps.map((step) => <li>{step}</li>)}</ol></article><article class="combo-panel"><div class="eyebrow">{comboCopy.detail.prerequisites}</div><h2>{comboCopy.detail.checkBefore}</h2><div class="combo-notes">{prerequisiteNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={saboCardAlt(note.cardId, lang)} lang={lang} />}<p>{note.text}</p></div>)}</div></article></div><div class="eyebrow">{comboCopy.detail.result}</div><h2>{comboCopy.detail.resultHeading}</h2><div class="combo-notes combo-result">{resultNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={saboCardAlt(note.cardId, lang)} lang={lang} />}<p>{note.text}</p></div>)}</div><div class="eyebrow">{comboCopy.detail.powerStates}</div><h2>{comboCopy.detail.powerStatesHeading}</h2><div class="power-state-grid">{combo.powerStates.map((state) => <article class="power-state"><CardImageButton id={state.cardId} alt={saboCardAlt(state.cardId, lang)} lang={lang} /><div><b>{state.label}</b><strong>{state.value}</strong></div></article>)}</div></GuideSection>; })}
   <CardModal deck={deck} extraCards={flexCards} metadataById={saboCardMetadataById} lang={lang} />
 </GuideLayout>

 <style>
   :global(.ideal-pair){align-items:flex-end;gap:6px}.ideal-pair :global(.card-cluster-separator){display:inline-flex;align-items:center;align-self:center;flex:0 0 auto;color:var(--red);font-size:11px;font-weight:950;letter-spacing:.04em}
  .visual-guide{position:relative}.visual-guide h2{max-width:760px}.guide-callout{display:grid;grid-template-columns:76px 1fr;gap:16px;align-items:center;margin:22px 0 14px;padding:14px;border:2px solid var(--line);border-radius:16px;background:var(--gold);box-shadow:7px 7px 0 var(--line)}.guide-callout-art :global(.card-image-button){width:76px;height:110px;overflow:hidden}.guide-callout-art :global(.card-image-button img){display:block;width:76px;height:110px;object-fit:cover;border:2px solid var(--line);border-radius:7px;box-shadow:4px 4px 0 var(--red)}.guide-callout p,.need-card p{margin:0;font-size:14px}.guide-callout strong{font-weight:950}.guide-note{margin:14px 0;font-size:14px;color:var(--muted)}.target-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.target-card{display:flex;align-items:center;gap:10px;min-width:0;padding:10px;border:2px solid var(--line);border-radius:13px;background:var(--card)}.target-card:nth-child(3n){background:var(--blue)}.target-card :global(.card-image-button){flex:0 0 58px;width:58px;height:84px;overflow:hidden}.target-card :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.target-card div{min-width:0}.target-card strong,.target-card span{display:block}.target-card strong{font-size:11px;color:var(--red);letter-spacing:.03em}.target-card span{font-size:13px;font-weight:900;line-height:1.15;margin-top:3px}.need-list{display:grid;gap:10px}.need-card{display:grid;grid-template-columns:58px 1fr;gap:12px;align-items:center;padding:11px;border:2px solid var(--line);border-radius:13px;background:var(--card)}.need-card:nth-child(odd){background:var(--green)}.need-card-art :global(.card-image-button){width:58px;height:84px;overflow:hidden}.need-card-art :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.need-card strong{display:block;color:var(--red);font-size:12px}.need-card h3{margin:2px 0 4px;font-size:18px;line-height:1}.need-card p{font-size:13px;line-height:1.35}@media(min-width:701px){.target-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.need-list{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-callout{max-width:760px}}@media(max-width:380px){.target-card{padding:8px;gap:7px}.target-card :global(.card-image-button),.need-card-art :global(.card-image-button){width:50px;height:73px}.target-card :global(.card-image-button img),.need-card-art :global(.card-image-button img){width:50px;height:73px}.need-card{grid-template-columns:50px 1fr;gap:9px}.target-card span{font-size:12px}}
</style>
