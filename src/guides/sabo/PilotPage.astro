---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import CardModal from '../../components/CardModal.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideSection from '../../components/GuideSection.astro';
import GuideJumpLinks from '../../components/GuideJumpLinks.astro';
import CardCluster from '../../components/CardCluster.astro';
import EffectBoardModal from '../../components/EffectBoardModal.astro';
import { cardImageUrl, saboCardMetadataById } from '../../data/sabo';
import { saboCombos } from '../../data/combos';
import { saboEffectBoard, saboNavigation, localizedSaboDeck, localizedSaboFlexCards, saboCardAlt } from './data';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const deck = localizedSaboDeck();
const flexCards = localizedSaboFlexCards();
const copy = {
  title: 'Elbaph Sabo Pilot',
  hero: { eyebrow: 'TOURNAMENT PILOT · RED / BLACK ELBAPH', heading: 'Play Sabo', byline: 'with a clear plan.', lede: 'Build a wide early board. Turn on Elbaph effects from 6 DON!!. Finish with safe attacks.' },
  startingHand: { eyebrow: 'STARTING HAND', heading: 'Keep a route to 12+.', tag: 'Quick rule', items: [
    { ids: ['OP01-016', 'OP17-086'], title: 'Find a starter', text: 'Red Nami finds Docking Six or a 2-cost starter. Black Nami fixes the hand with two draws.' },
    { ids: ['OP17-080', 'OP17-082'], title: 'Set the trash', text: 'Usopp is the main value and trash setup. Sanji filters the hand and sends recovery targets to the trash.' },
    { ids: ['OP17-089', 'OP17-119'], title: 'Reach 12+', text: 'Saul is the low-cost enabler. Loki is the preferred 12+ body.' },
    { ids: ['OP15-088', 'OP17-093'], title: 'Keep one payoff', text: 'Keep Docking Six or Luffy when your hand already has a route to the needed 2-cost card.' },
  ] },
  model: { eyebrow: 'PILOT MODEL', heading: 'Wide board. Safe finish.', reminderHeading: 'Remember the life and DON!! rules.', reminder: 'Take the first two Life cards in common games. Stop at about 3 Life when the opponent can finish. From 6 DON!!, turn on Elbaph effects with a 12+ body. With 1 DON!! and your own 8+ Character, Sabo gives your Leader and Characters +1000 power. Hold 1 DON!! for +4000 defense when practical.', tag: 'Card text + guide rule', stepsEyebrow: 'TOURNAMENT PILOT · DO THIS IN ORDER', stepTag: 'Quick rule', steps: [
    { title: 'Mulligan', ids: ['OP01-016', 'OP17-086', 'OP17-080'], text: 'Keep a starter and a route to Usopp, Sanji, or Saul. Keep a payoff only when the hand can reach 12+.' },
    { title: 'Choose the turn order', ids: ['OP01-016', 'OP17-080'], text: 'Going first: 1 Nami, then 3 Usopp or Sanji. Going second: 2 Usopp or Sanji, then build two 2-cost bodies or play Saul.' },
    { title: 'Build the trash', ids: ['OP17-080', 'OP17-082', 'OP17-089'], text: 'Use Usopp as the main value and trash setup. Use Sanji to filter. Use Saul as the low-cost 12+ enabler.' },
    { title: 'Use Docking Six', ids: ['OP15-088', 'OP17-080', 'OP17-082'], text: 'Recover the 2-cost card that matches the board. Choose Usopp or Sanji for value, Zoro for Loki protection, Robin for a key reduction, Brook for leader DON!!, or Jinbe for defense.' },
    { title: 'Choose the 12+ body', ids: ['OP17-119', 'OP17-089'], text: 'Prefer Loki when you need its opponent-turn +3000 and its cost-4-or-less KO. Use Saul when you need the low-cost enabler.' },
    { title: 'Attack in order', ids: ['OP17-087', 'OP17-083', 'OP17-095'], text: 'Use Robin for a key cost reduction or trade. Keep Jinbe ready for defense. Keep Zoro when effect removal can matter.' },
    { title: 'Close the game', ids: ['OP17-093', 'ST01-011', 'OP17-084'], text: 'Play Luffy for a Rush attack and a generic 2-cost recovery. Prefer Brook for leader DON!!. Use Robin for a key reduction, Jinbe as a blocker, or Chopper for an unblockable finish.' },
  ] },
  replayTargets: { eyebrow: 'LUFFY · OP17-093', heading: 'OP17-093 Luffy replay targets', onPlay: 'On Play:', text: 'Draw 1 card. Play up to 1 Character card with a cost of 2 or less from your trash. A 12+ Character gives Luffy Rush.', note: 'Choose the target that matches the board state.', ids: ['OP01-016', 'ST01-011', 'OP17-084', 'OP17-086', 'OP17-080', 'OP17-083', 'OP17-087', 'OP17-095', 'OP17-082'] },
  searchPriority: { eyebrow: 'SEARCH · USE THE BOARD STATE', heading: 'Recovery choices by need', note: 'Choose the target that gives the turn its needed result.', items: [
    { need: 'Need Docking Six or a starter', id: 'OP01-016', name: 'Red Nami', text: 'Use Red Nami early. Look at 5 cards and add Docking Six or another Straw Hat Crew starter.' },
    { need: 'Need two cards', id: 'OP17-086', name: 'Black Nami', text: 'Use Black Nami when Docking Six and Usopp are ready, or when an Elbaph card in hand can become two draws.' },
    { need: 'Need value and trash setup', id: 'OP17-080', name: 'Usopp', text: 'Use Usopp early. Look at the top 3, add an Elbaph card, and trash the rest.' },
    { need: 'Need hand filter', id: 'OP17-082', name: 'Sanji', text: 'Use Sanji when you need to draw 2 and trash 2. This places recovery targets in the trash.' },
    { need: 'Need protection', id: 'OP17-095', name: 'Roronoa Zoro', text: 'Use Zoro as a 2K counter, or keep it on board to replace effect removal with 3 cards from your trash.' },
    { need: 'Need a finish attack', id: 'OP17-084', name: 'Tony Tony.Chopper', text: 'Use Chopper when a 12+ body is live. Give the chosen attack [Unblockable].' },
  ] },
  curve: { eyebrow: 'IDEAL DON!! CURVE', heading: 'Use the standard curves.', note: 'These curves show the source plan. Hold 1 DON!! for +4000 defense when practical.', tag: 'Tournament reference', lanes: [
    { heading: 'Going first', turns: [
      { title: 'Turn 1 · 1 DON!!', ids: ['OP01-016', 'OP17-086'], separators: ['OR'], text: 'Play Nami. Red Nami finds Docking Six or a 2-cost starter. Black Nami filters the hand.' },
      { title: 'Turn 2 · 3 DON!!', ids: ['OP17-080', 'OP17-082'], separators: ['OR'], text: 'Play Usopp or Sanji. Set up value and the trash.' },
      { title: 'Turn 3 · 5 DON!!', ids: ['OP15-088', 'OP17-080', 'OP17-089'], separators: ['+', 'OR'], text: 'Play Docking Six and recover Usopp, or play Saul. Use Saul when you need the low-cost 12+ enabler.' },
      { title: 'Turn 4 · 7 DON!!', ids: ['OP17-119', 'OP15-088'], separators: ['OR'], text: 'Play Loki, or use Docking Six to recover the needed 2-cost card.' },
      { title: 'Turn 5 · 9 DON!!', ids: ['OP17-093', 'OP17-087'], separators: ['+'], text: 'Play Luffy and recover the needed 2-cost card. Use Robin for a key cost reduction or trade.' },
      { title: 'Turn 6 · 10 DON!!', ids: ['OP17-093', 'OP17-083'], separators: ['+'], text: 'Play Luffy and the situational 2-cost card. Choose Jinbe for defense, Robin for a trade, Brook for leader DON!!, or Chopper for the finish.' },
    ] },
    { heading: 'Going second', turns: [
      { title: 'Turn 1 · 2 DON!!', ids: ['OP17-080', 'OP17-082'], separators: ['OR'], text: 'Play Usopp or Sanji. Start the value and trash setup.' },
      { title: 'Turn 2 · 4 DON!!', ids: ['OP17-080', 'OP17-083', 'OP17-089'], separators: ['+', 'OR'], text: 'Play two 2-cost bodies, or play Saul.' },
      { title: 'Turn 3 · 6 DON!!', ids: ['OP15-088', 'OP17-119'], separators: ['OR'], text: 'Play Docking Six if Saul is in play. Otherwise play Loki.' },
      { title: 'Turn 4 · 8 DON!!', ids: ['OP17-093', 'ST01-011'], separators: ['+'], text: 'Play Luffy and prefer Brook as the replay target for leader DON!!. Delay Luffy for Docking Six if Brook is not in the trash.' },
      { title: 'Turn 5 · 10 DON!!', ids: ['OP17-093', 'OP17-087', 'OP17-083', 'ST01-011'], separators: ['+', 'OR', 'OR'], text: 'Play Luffy and recover Robin, Jinbe, or Brook. Choose Robin for a key reduction, Jinbe for defense, or Brook for leader DON!!.' },
    ] },
  ] },
};
const keep = copy.startingHand.items;
const steps = copy.model.steps;
const curves = copy.curve.lanes;
const searchNeeds = copy.searchPriority.items.map((item) => ({ need: item.need, id: item.id, text: item.text, name: item.name }));
const comboCopy = {
   index: { eyebrow: 'THREE TOURNAMENT LINES', heading: 'Make the line.', byline: 'Check the cost.', lede: 'Use these short lines after you build your board. Check your DON!! before you start.', listLabel: 'Combo lines', openGuide: 'OPEN GUIDE', openGuideText: 'See cards, steps, and power states.', openBoard: 'OPEN BOARD', closeBoard: 'Close board', noticeHeading: 'Simple order.', noticeText: 'Find the 12+ body. Build wide. Then use Luffy or your 6K bodies to close.' },
  detail: { cardsUsed: 'CARDS USED', howToPlay: 'HOW TO PLAY', followSteps: 'Follow these steps.', prerequisites: 'PREREQUISITES', checkBefore: 'Check before you start.', result: 'RESULT', resultHeading: 'What the line gives you.', powerStates: 'POWER STATES', powerStatesHeading: 'See the change.' },
};
const comboDetails = saboCombos;
const effectBoard = saboEffectBoard;
---
<GuideLayout title={copy.title} active="pilot" lang={lang} navigation={saboNavigation(lang)}>
  <GuideHero eyebrow={copy.hero.eyebrow} heading={copy.hero.heading} byline={copy.hero.byline} lede={copy.hero.lede} cards={[{ id: 'OP13-004', alt: saboCardAlt('OP13-004', 'Sabo leader') }, { id: 'OP17-089', alt: saboCardAlt('OP17-089', 'Jaguar.D.Saul') }]} lang={lang} />
   <GuideJumpLinks ariaLabel={'Guide sections'} links={[{ href: '#starting-hand', label: 'Starting hand' }, { href: '#curve', label: 'DON!! curve' }, { href: '#turn-plan', label: 'Turn plan' }, { href: '#combos', label: 'Combos' }]} />
   <div class="pilot-map" aria-label={'How to play Sabo'}><span>{'1 · Find pieces'}</span><i aria-hidden="true">→</i><span>{'2 · Build wide'}</span><i aria-hidden="true">→</i><span>{'3 · Reach 12+'}</span><i aria-hidden="true">→</i><span>{'4 · Close with Luffy'}</span></div>
   <GuideSection id="starting-hand"><div class="eyebrow">{copy.startingHand.eyebrow}</div><h2>{copy.startingHand.heading}</h2><div class="overview">{keep.map((item)=><article class="keep"><CardCluster ids={item.ids} alt={(id) => saboCardAlt(id)} wrapperClass="guidance-art" lang={lang} /><h3>{item.title}</h3><p>{item.text} <span class="tag">{copy.startingHand.tag}</span></p></article>)}</div></GuideSection>
    <GuideSection id="curve"><div class="eyebrow">{copy.curve.eyebrow}</div><h2>{copy.curve.heading}</h2><p class="source">{copy.curve.note}</p><div class="ideal-curve">{curves.map((lane)=><article class="ideal-lane"><h3>{lane.heading}</h3>{lane.turns.map((turn)=><div class="ideal-step"><CardCluster ids={turn.ids} separators={turn.separators as ('OR' | '+')[]} alt={(id) => saboCardAlt(id)} wrapperClass="ideal-pair" lang={lang} /><div><h4>{turn.title}</h4><p>{turn.text}</p><span class="tag">{copy.curve.tag}</span></div></div>)}</article>)}</div></GuideSection>
     <GuideSection id="turn-plan"><div class="eyebrow">{copy.model.eyebrow}</div><h2>{copy.model.heading}</h2><div class="notice"><CardCluster ids={['OP13-004','OP17-089','OP17-119','OP17-093']} alt={(id) => saboCardAlt(id)} wrapperClass="threshold-art" lang={lang} /><b>{copy.model.reminderHeading}</b><p>{copy.model.reminder} <span class="tag">{copy.model.tag}</span></p></div><div class="eyebrow">{copy.model.stepsEyebrow}</div><div class="pilot-flow">{steps.map((step,index)=><article class="pilot-step"><div class="step-no">{index + 1}</div><div><CardCluster ids={step.ids} alt={(id) => saboCardAlt(id)} wrapperClass="guidance-art" lang={lang} /><h3>{step.title}</h3><p>{step.text}</p><span class="tag">{copy.model.stepTag}</span></div></article>)}</div></GuideSection>
     <GuideSection class="section visual-guide" aria-labelledby="replay-targets-title"><div class="eyebrow">{copy.replayTargets.eyebrow}</div><h2 id="replay-targets-title">{copy.replayTargets.heading}</h2><div class="guide-callout"><div class="guide-callout-art"><CardImageButton id="OP17-093" alt={saboCardAlt('OP17-093', 'OP17-093 Monkey.D.Luffy')} lang={lang} /></div><p><strong>{copy.replayTargets.onPlay}</strong> {copy.replayTargets.text}</p></div><p class="guide-note">{copy.replayTargets.note}</p><div class="target-grid">{copy.replayTargets.ids.map((id) => { const card = saboCardMetadataById[id]; return <article class="target-card"><CardImageButton id={id} alt={saboCardAlt(id, `${id} ${card.name}`)} lang={lang} /><div><strong>{id}</strong><span>{card.name}</span></div></article>; })}</div></GuideSection>
   <GuideSection class="section visual-guide" aria-labelledby="search-priority-title"><div class="eyebrow">{copy.searchPriority.eyebrow}</div><h2 id="search-priority-title">{copy.searchPriority.heading}</h2><p class="guide-note">{copy.searchPriority.note}</p><div class="need-list">{searchNeeds.map((item)=><article class="need-card"><div class="need-card-art"><CardImageButton id={item.id} alt={saboCardAlt(item.id, `${item.id} ${item.name ?? ''}`)} lang={lang} /></div><div><strong>{item.need}</strong><h3>{item.name ?? ''}</h3><p>{item.text}</p></div></article>)}</div></GuideSection>
     <GuideSection id="combos" class="section visual-guide" aria-labelledby="combo-lines-title"><div class="eyebrow">{comboCopy.index.eyebrow}</div><h2 id="combo-lines-title">{comboCopy.index.heading}<br /><em>{comboCopy.index.byline}</em></h2><p class="lede">{comboCopy.index.lede}</p><div class="combo-grid" aria-label={comboCopy.index.listLabel}>{comboDetails.map((combo) => <article class="combo-card"><div class="combo-art">{combo.cards.slice(0, 2).map((id) => <CardImageButton id={id} alt={saboCardAlt(id)} lang={lang} />)}</div><div class="combo-copy"><div class="eyebrow">{combo.number}</div><h3>{combo.title}</h3><p>{combo.summary}</p><div class="combo-step"><b>{comboCopy.index.openGuide}</b>{comboCopy.index.openGuideText}</div>{combo.slug === 'saul-sixes' && <EffectBoardModal modalId="sabo-saul-sixes-board" triggerLabel={comboCopy.index.openBoard} closeLabel={comboCopy.index.closeBoard} title={effectBoard.title} steps={effectBoard.steps} labels={effectBoard.labels} imageForCard={cardImageUrl} altForCard={(id: string) => saboCardAlt(id)} />}</div></article>)}</div><div class="notice"><b>{comboCopy.index.noticeHeading}</b> {comboCopy.index.noticeText}</div></GuideSection>
    {comboDetails.map((combo) => { const prerequisiteNotes = combo.prerequisites.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text })); const resultNotes = combo.result.map((note) => ({ cardId: 'cardId' in note ? note.cardId : undefined, text: note.text })); return <GuideSection class="combo-detail-section" aria-labelledby={`combo-${combo.slug}-title`}><div class="eyebrow">{combo.number}</div><h2 id={`combo-${combo.slug}-title`}>{combo.title}</h2><p class="lede">{combo.summary}</p><div class="eyebrow">{comboCopy.detail.cardsUsed}</div><div class="combo-detail-cards">{combo.cards.map((id) => <CardImageButton id={id} alt={saboCardAlt(id)} lang={lang} />)}</div><div class="combo-detail-grid"><article class="combo-panel"><div class="eyebrow">{comboCopy.detail.howToPlay}</div><h2>{comboCopy.detail.followSteps}</h2><ol class="combo-steps">{combo.steps.map((step) => <li>{step}</li>)}</ol></article><article class="combo-panel"><div class="eyebrow">{comboCopy.detail.prerequisites}</div><h2>{comboCopy.detail.checkBefore}</h2><div class="combo-notes">{prerequisiteNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={saboCardAlt(note.cardId)} lang={lang} />}<p>{note.text}</p></div>)}</div></article></div><div class="eyebrow">{comboCopy.detail.result}</div><h2>{comboCopy.detail.resultHeading}</h2><div class="combo-notes combo-result">{resultNotes.map((note) => <div class="combo-note">{note.cardId && <CardImageButton id={note.cardId} alt={saboCardAlt(note.cardId)} lang={lang} />}<p>{note.text}</p></div>)}</div><div class="eyebrow">{comboCopy.detail.powerStates}</div><h2>{comboCopy.detail.powerStatesHeading}</h2><div class="power-state-grid">{combo.powerStates.map((state) => <article class="power-state"><CardImageButton id={state.cardId} alt={saboCardAlt(state.cardId)} lang={lang} /><div><b>{state.label}</b><strong>{state.value}</strong></div></article>)}</div></GuideSection>; })}
   <CardModal deck={deck} extraCards={flexCards} metadataById={saboCardMetadataById} lang={lang} />
 </GuideLayout>

  <style>
    :global(.ideal-pair){align-items:flex-end;gap:6px}.ideal-pair :global(.card-cluster-separator){display:inline-flex;align-items:center;align-self:center;flex:0 0 auto;color:var(--red);font-size:11px;font-weight:950;letter-spacing:.04em}
   .pilot-map{display:flex;align-items:center;gap:9px;margin:4px 0 4px;padding:12px 14px;border:2px solid var(--line);border-radius:15px;background:var(--ink);color:var(--paper);font-size:12px;font-weight:950;overflow-x:auto;white-space:nowrap;box-shadow:7px 7px 0 var(--red)}.pilot-map span{padding:5px 8px;border-radius:99px;background:var(--gold);color:var(--ink)}.pilot-map i{color:var(--gold);font-style:normal;font-size:17px}.pilot-map+section{margin-top:34px}
   .visual-guide{position:relative;scroll-margin-top:20px}.visual-guide h2{max-width:760px}.guide-callout{display:grid;grid-template-columns:76px 1fr;gap:16px;align-items:center;margin:22px 0 14px;padding:14px;border:2px solid var(--line);border-radius:16px;background:var(--gold);box-shadow:7px 7px 0 var(--line)}.guide-callout-art :global(.card-image-button){width:76px;height:110px;overflow:hidden}.guide-callout-art :global(.card-image-button img){display:block;width:76px;height:110px;object-fit:cover;border:2px solid var(--line);border-radius:7px;box-shadow:4px 4px 0 var(--red)}.guide-callout p,.need-card p{margin:0;font-size:14px}.guide-callout strong{font-weight:950}.guide-note{margin:14px 0;font-size:14px;color:var(--muted)}.target-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.target-card{display:flex;align-items:center;gap:10px;min-width:0;padding:10px;border:2px solid var(--line);border-radius:13px;background:var(--card);transition:transform .18s ease,box-shadow .18s ease}.target-card:hover,.target-card:focus-within{transform:translateY(-2px);box-shadow:4px 4px 0 var(--red)}.target-card:nth-child(3n){background:var(--blue)}.target-card :global(.card-image-button){flex:0 0 58px;width:58px;height:84px;overflow:hidden}.target-card :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.target-card div{min-width:0}.target-card strong,.target-card span{display:block}.target-card strong{font-size:11px;color:var(--red);letter-spacing:.03em}.target-card span{font-size:13px;font-weight:900;line-height:1.15;margin-top:3px}.need-list{display:grid;gap:10px}.need-card{display:grid;grid-template-columns:58px 1fr;gap:12px;align-items:center;padding:11px;border:2px solid var(--line);border-radius:13px;background:var(--card);transition:transform .18s ease,box-shadow .18s ease}.need-card:hover,.need-card:focus-within{transform:translateX(3px);box-shadow:4px 4px 0 var(--blue)}.need-card:nth-child(odd){background:var(--green)}.need-card-art :global(.card-image-button){width:58px;height:84px;overflow:hidden}.need-card-art :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}.need-card strong{display:block;color:var(--red);font-size:12px}.need-card h3{margin:2px 0 4px;font-size:18px;line-height:1}.need-card p{font-size:13px;line-height:1.35}@media(min-width:701px){.target-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.need-list{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-callout{max-width:760px}}@media(max-width:380px){.target-card{padding:8px;gap:7px}.target-card :global(.card-image-button),.need-card-art :global(.card-image-button){width:50px;height:73px}.target-card :global(.card-image-button img),.need-card-art :global(.card-image-button img){width:50px;height:73px}.need-card{grid-template-columns:50px 1fr;gap:9px}.target-card span{font-size:12px}}
</style>
