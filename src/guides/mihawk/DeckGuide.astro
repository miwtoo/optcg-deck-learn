---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import CardModal from '../../components/CardModal.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideSection from '../../components/GuideSection.astro';
import DonFlow from '../../components/DonFlow.astro';
import DeckExportPanel from '../../components/DeckExportPanel.astro';
import { mihawkDeck, mihawkDeckTotal, mihawkCardMetadataById, mihawkCardArtVariants, mihawkCardImageUrl } from '../../data/mihawk';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const deck = mihawkDeck;
const mainDeckTotal = mihawkDeckTotal - 1;
const egmanExport = deck.map((card) => `${card.quantity} ${card.id} ${card.name}`).join('\n');
const groups = [
  { id: 'leader', label: 'Leader' },
  { id: 'search-setup', label: 'Search / setup' },
  { id: 'characters', label: 'Characters' },
  { id: 'rest-effects', label: 'Rest effects' },
  { id: 'events', label: 'Events' },
];
const groupById: Readonly<Record<string, string>> = {
  'OP14-020': 'leader',
  'OP07-022': 'search-setup',
  'OP12-034': 'search-setup',
  'OP14-023': 'rest-effects',
  'OP14-039': 'rest-effects',
  'OP01-055': 'events',
  'OP12-037': 'events',
  'OP13-040': 'events',
  'OP14-036': 'events',
};
const groupBy = (card: { readonly id: string }) => groupById[card.id] ?? (card.id === 'OP12-023' ? 'search-setup' : 'characters');
const navigation = [
  { id: 'deck', label: 'Deck', path: '/mihawk/' },
  { id: 'pilot', label: 'Pilot', path: '/mihawk/pilot/' },
];
const copyText = { eyebrow: 'EGMAN EVENTS DECK BUILDER', title: 'Copy the deck list.', copy: 'Copy list', copied: 'Copied', copiedStatus: 'Copied to your clipboard.' };
---
<GuideLayout title="Green Dracule Mihawk · OP14-020" active="deck" lang={lang} guideBase="/mihawk" brand="ONE PIECE · OP14" navigation={navigation}>
  <GuideHero eyebrow="GREEN · SLASH" heading="Dracule Mihawk" byline="OP14-020" lede="Play your effects first. Rest one card. Turn up to 3 DON!! active." chips={['OP14-020 Leader', `1 leader + ${mainDeckTotal} cards`]} cards={[{ id: 'OP14-020', alt: 'Dracule Mihawk leader' }, { id: 'OP14-119', alt: 'Dracule Mihawk' }]} imageUrl={mihawkCardImageUrl} lang={lang} />
  <div class="notice"><b>Leader sequence.</b> Play Characters and use their effects first. Confirm either field has a cost 5 or more Character. Rest your card. Set up to 3 DON!! active. Do not play more Characters. Use active DON!! for attacks, Events, and effects.</div>
   <GuideSection><div class="eyebrow">THE SIMPLE PLAN</div><h2>Make the rest count.</h2><div class="overview">{([
    { title: '1 · Play effects first', text: 'Play Characters and use their effects before you use the Leader effect.' },
    { title: '2 · Confirm the field', text: 'Either field must have a Character with a cost of 5 or more.' },
    { title: '3 · Rest one card', text: 'Rest a card, then set up to 3 DON!! active with the Leader effect.' },
    { title: '4 · Use the DON!!', text: 'Use active DON!! for attacks, Events, and Character effects. Do not play more Characters this turn.' },
    ]).map((step) => <article class="tile"><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></GuideSection>
   <GuideSection><DonFlow items={['Play effects', 'Confirm 5+', 'Rest', '+ active DON!!', 'Attack or use Events']} /></GuideSection>
   <GuideSection><div class="eyebrow">DEVELOPMENT</div><h2>Build at 5 or 6 DON!!</h2><div class="overview">{([
    { title: '5 DON!!', text: 'Play a 5-cost Character. This gives the Leader a valid 5+ Character for its effect.' },
    { title: '6 DON!!', text: 'ST32-003 Dracule Mihawk deploys a 5-cost-or-less Perona or Slash Character from your hand. The Leader can then rest that Character.' },
    { title: '9 or 10 DON!!', text: 'Use the active DON!! for large Characters and a finish. ST24-004 Law & Bepo and OP14-119 Dracule Mihawk are finishers in this list.' },
    { title: 'Keep a counter', text: 'Plan your Counter Events before you use all active DON!!. ST16-004 Shanks and ST24-004 Law & Bepo are Characters in this list. OP01-055 is a Main Event, not a Counter Event.' },
    ]).map((step) => <article class="tile"><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></GuideSection>
   <GuideSection><div class="countline"><div><div class="eyebrow">THE EXACT LIST</div><h2>{`1 leader + ${mainDeckTotal} cards`}</h2></div><div class="count">{`✓ Counted: ${mainDeckTotal}`}</div></div><CardGrid deck={deck} metadataById={mihawkCardMetadataById} imageUrl={mihawkCardImageUrl} groups={groups} groupBy={groupBy} lang={lang} /><p class="source">This list uses every card and quantity in the Tone source file.</p></GuideSection>
   <DeckExportPanel eyebrow={copyText.eyebrow} title={copyText.title} deckText={egmanExport} copyLabel={copyText.copy} copiedLabel={copyText.copied} copiedStatus={copyText.copiedStatus} />
   <div class="notice"><a class="button" href={`${import.meta.env.BASE_URL}/mihawk/pilot/`}>Open the Pilot guide →</a><p>Learn the Leader sequence and development points.</p></div>
    <GuideSection><div class="eyebrow">SOURCES</div><p>The exact list comes from the local Tone source file. The official card page confirms rules and overlapping-card interactions.</p><p><a href="https://asia-en.onepiece-cardgame.com/feature/deck/deck_102.php">Official One Piece Card Game deck page</a></p></GuideSection>
   <CardModal deck={deck} metadataById={mihawkCardMetadataById} artVariants={mihawkCardArtVariants} imageUrl={mihawkCardImageUrl} extraCards={[]} lang={lang} />
</GuideLayout>

<style>
  .card strong,.card small{overflow-wrap:anywhere;word-break:break-word}
</style>
