---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import CardModal from '../../components/CardModal.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideSection from '../../components/GuideSection.astro';
import GuideJumpLinks from '../../components/GuideJumpLinks.astro';
import CardCluster from '../../components/CardCluster.astro';
import { mihawkDeck, mihawkCombos, mihawkCardMetadataById, mihawkCardArtVariants, mihawkCardImageUrl } from '../../data/mihawk';
import { mihawkThaiNavigation, mihawkThaiPilot } from '../../content/mihawk/th';
import type { Locale } from '../../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const locale: Locale = lang === 'th' ? 'th' : 'en';
const isThai = locale === 'th';
const englishPilot = {
  cardAlt: (id: string) => `${id} card`,
  hero: {
    eyebrow: 'PILOT GUIDE · GREEN SLASH',
    title: 'Play Mihawk',
    titleEmphasis: 'one clear step at a time.',
    lede: 'Set up your hand. Rest one card. Turn DON!! active.',
    chips: ['Flexible guide', 'Card text inference'],
    leaderAlt: 'OP14-020 Dracule Mihawk leader',
    characterAlt: 'ST32-003 Dracule Mihawk',
  },
  disclosure: {
    title: 'Flexible guide · Inference from card text',
    text: 'Your choice can change with your hand and field. Use this page as a menu, not a fixed rule.',
  },
  mulligan: {
    eyebrow: 'MULLIGAN', title: 'Keep a line you can use.',
    note: 'These are useful choices. Do not treat any one choice as always required.',
    items: [
      { ids: ['OP12-034', 'OP07-022'], title: 'Setup cards', text: 'Perona and Otama help you set up your hand.' },
      { ids: ['OP07-026', 'ST32-003'], title: 'Development', text: 'A 5-cost Character or ST32-003 Mihawk can give you a development line.' },
      { ids: ['OP14-023', 'OP14-039'], title: 'Rest targets', text: 'Kikunojo and Coffin Boat are useful cards to rest.' },
      { ids: ['OP14-119', 'ST24-004'], title: 'Top end', text: 'A 9- or 10-cost card can wait unless your hand has setup or development.' },
    ],
  },
  curve: {
    eyebrow: 'CURVE', title: 'Use the DON!! checklist.', note: 'At each level, choose one shown card and take the listed action. OR means choose one, not both. When you use the Leader effect, follow Leader Sequence. At 9–10 DON!!, use Finish for the closing plan.', tag: 'One choice · OR means choose one.',
    lanes: [{ heading: 'Sample curve', turns: [
       { don: '1–4 DON!!', ids: ['OP12-034', 'OP07-022', 'OP14-039', 'OP14-023'], separators: ['OR', 'OR', 'OR'], title: 'Choose one · Set up', text: '1. Choose one shown card. 2. Use Perona, Otama, Coffin Boat, or Kikunojo. 3. If you use the Leader effect, follow Leader Sequence.' },
       { don: '5 DON!!', ids: ['OP07-026', 'OP10-030', 'OP12-023', 'OP14-033', 'ST32-002'], separators: ['OR', 'OR', 'OR', 'OR'], title: 'Choose one · Meet the condition', text: '1. Choose one shown card. 2. Play a 5-cost Character. Either field must have a Character with a cost of 5 or more. 3. If you use the Leader effect, follow Leader Sequence.' },
       { don: '6 DON!!', ids: ['ST32-003', 'OP13-031'], separators: ['OR'], title: 'Choose one · Deploy', text: '1. Choose one shown card. 2. Use ST32-003 or OP13-031 before the Leader effect. 3. Use the Leader effect, then follow Leader Sequence.' },
       { don: '9 DON!!', ids: ['OP14-119', 'ST16-004'], separators: ['OR'], title: 'Choose one · Top end', text: '1. Choose one shown card. 2. Use OP14-119 or ST16-004. Shanks K.O.s an already-rested Character. 3. Use Finish for the closing plan.' },
       { don: '10 DON!!', ids: ['ST24-004'], separators: [], title: 'Choose one · Control', text: '1. Choose the shown card. 2. Use Law & Bepo to rest a Character and keep it inactive during the next Refresh Phase. 3. Use Finish for the closing plan.' },
    ] }],
  },
  sequence: {
    eyebrow: 'LEADER SEQUENCE', title: 'Resolve the lock in order.',
    items: [
      { ids: ['OP12-034', 'OP07-022', 'ST32-003', 'OP13-031'], title: 'Play Characters first', text: 'Play all Characters and use any Character-playing effects.' },
      { ids: ['OP14-020'], title: 'Confirm the field', text: 'Either field must have a Character with a cost of 5 or more.' },
      { ids: ['OP14-023', 'OP14-039'], title: 'Rest your card', text: 'Rest one of your cards.' },
      { ids: ['OP14-020'], title: 'Set DON!! active', text: 'Set up to 3 DON!! cards as active.' },
      { ids: [], title: 'Lock Character play', text: 'Do not play more Character cards during this turn.' },
      { ids: ['OP01-055', 'OP12-037', 'OP13-040', 'OP14-036'], title: 'Use or keep DON!!', text: 'Use DON!! only for legal non-Character actions, or keep it.' },
    ],
  },
  finish: {
    eyebrow: 'FINISH', title: 'Finish the game in order.', note: 'Sample finish plan. Change it to fit your hand and field.',
    items: [
      { ids: [], separators: [], title: '1 · Rest an opposing target', text: 'First, rest one opposing target with a legal effect. This sets up your finish.' },
      { ids: ['ST16-004', 'OP14-119'], separators: ['OR'], title: '2 · Choose your 9 DON!! line', text: 'At 9 DON!!, choose Shanks to K.O. a rested Character, or choose 9-cost Mihawk to keep a key opposing Character from becoming rested.' },
      { ids: ['ST24-004', 'OP14-020'], separators: [], title: '3 · Use the 10 DON!! line', text: 'At 10 DON!!, use Law & Bepo to rest a Character and keep it inactive. The Leader power bonus needs 2 rested opposing Characters.' },
      { ids: ['ST16-004', 'ST24-004', 'OP14-020'], separators: [], title: '4 · Resolve, then attack', text: 'Resolve Character effects before the Leader effect. The Leader effect stops more Character plays this turn. Use active DON!! for attacks or Counter Events.' },
    ],
  },
  tips: {
    eyebrow: 'TIPS', title: 'Know what each rest gives you.', targetLabel: 'GOOD TARGET',
    items: [
      { id: 'OP14-023', title: 'Kikunojo', text: 'Becomes active at the end of your turn.' },
      { id: 'OP14-039', title: 'Coffin Boat', text: 'Has its own end-of-turn 1 DON!! active effect.' },
      { id: 'ST32-003', title: 'ST32-003 Mihawk', text: 'When rested, draw 1 and trash 1.' },
      { id: 'OP14-119', title: 'OP14-119 Mihawk', text: 'When rested, an opposing cost-9-or-less Character cannot become rested until the opponent’s End Phase.' },
    ],
  },
  combos: { eyebrow: 'COMBOS', title: 'Use these four card lines.', note: 'Resolve each line before you use the Leader effect.', items: mihawkCombos },
  defense: { eyebrow: 'DEFENSE', title: 'Keep the counter facts clear.', cardIds: ['OP12-037', 'OP13-040', 'OP14-036', 'OP01-055'], facts: ['OP12-037 and OP13-040 give +3000 Counter.', 'OP14-036 gives +4000 Counter only after you rest a card.', 'OP01-055 is Main-only.'] },
  effectComparison: {
    eyebrow: 'DO NOT MIX THESE EFFECTS', title: 'Read the target carefully.',
    items: [
      { id: 'ST16-004', title: 'Shanks', text: 'K.O.s an already-rested Character.' },
      { id: 'OP14-119', title: 'OP14-119 Mihawk', text: 'Prevents an opposing Character from becoming rested.' },
      { id: 'ST24-004', title: 'Law & Bepo', text: 'Rests a Character, then keeps it inactive.' },
    ],
  },
  leaderFact: { eyebrow: 'LEADER FACT', text: 'Against an opposing Leader with the Slash attribute, OP14-020 gains +1000 power.', leaderAlt: 'OP14-020 Dracule Mihawk leader' },
};
const pilot = isThai ? mihawkThaiPilot : englishPilot;
const curves = pilot.curve.lanes;
const navigation = isThai
  ? [
      { id: 'deck', label: mihawkThaiNavigation.deck, path: '/mihawk/' },
      { id: 'pilot', label: mihawkThaiNavigation.pilot, path: '/mihawk/pilot/' },
    ]
  : [
      { id: 'deck', label: 'Deck', path: '/mihawk/' },
      { id: 'pilot', label: 'Pilot', path: '/mihawk/pilot/' },
    ];
---
<GuideLayout title={isThai ? mihawkThaiPilot.title : 'Green Dracule Mihawk Pilot'} active="pilot" lang={locale} guideBase="/mihawk" brand="ONE PIECE · OP14" navigation={navigation}>
  <GuideHero eyebrow={pilot.hero.eyebrow} heading={isThai ? mihawkThaiPilot.hero.title : englishPilot.hero.title} byline={isThai ? '' : englishPilot.hero.titleEmphasis} lede={pilot.hero.lede} chips={pilot.hero.chips} cards={[{ id: 'OP14-020', alt: pilot.hero.leaderAlt }, { id: 'ST32-003', alt: isThai ? 'ST32-003 Dracule Mihawk' : englishPilot.hero.characterAlt }]} imageUrl={mihawkCardImageUrl} lang={locale} />
  <div class="notice disclosure"><b>{pilot.disclosure.title}</b><p>{pilot.disclosure.text}</p></div>
  <GuideJumpLinks ariaLabel={isThai ? 'หัวข้อในคู่มือ' : 'Guide sections'} links={isThai ? [{ href: '#mulligan', label: 'มุลลิแกน' }, { href: '#curve', label: 'ลำดับ DON!!' }, { href: '#leader-sequence', label: 'ลำดับลีดเดอร์' }, { href: '#finish', label: 'ปิดเกม' }, { href: '#mihawk-combos', label: 'คอมโบ' }] : [{ href: '#mulligan', label: 'Mulligan' }, { href: '#curve', label: 'Curve' }, { href: '#leader-sequence', label: 'Leader order' }, { href: '#finish', label: 'Finish' }, { href: '#mihawk-combos', label: 'Combos' }]} />

  <GuideSection id="mulligan" class="section visual-guide" aria-labelledby="mulligan-title"><div class="eyebrow">{pilot.mulligan.eyebrow}</div><h2 id="mulligan-title">{pilot.mulligan.title}</h2><p class="guide-note">{pilot.mulligan.note}</p><div class="mulligan-grid">{pilot.mulligan.items.map((item) => <article class="visual-card"><CardCluster ids={item.ids} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} lang={locale} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></GuideSection>

  <GuideSection id="curve" class="section visual-guide" aria-labelledby="curve-title"><div class="eyebrow">{pilot.curve.eyebrow}</div><h2 id="curve-title">{pilot.curve.title}</h2><p class="source">{pilot.curve.note}</p><div class="ideal-curve">{curves.map((lane)=><article class="ideal-lane"><h3>{lane.heading}</h3>{lane.turns.map((turn)=><div class="ideal-step"><CardCluster ids={turn.ids} separators={turn.separators as ('OR' | '+')[]} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} wrapperClass="ideal-pair" lang={locale} /><div><h4>{turn.don} · {turn.title}</h4><p>{turn.text}</p><span class="tag">{pilot.curve.tag}</span></div></div>)}</article>)}</div></GuideSection>

  <GuideSection id="leader-sequence" class="section visual-guide" aria-labelledby="sequence-title"><div class="eyebrow">{pilot.sequence.eyebrow}</div><h2 id="sequence-title">{pilot.sequence.title}</h2><div class="pilot-flow sequence-flow">{pilot.sequence.items.map((step, index) => <article class="pilot-step"><div class="step-no">{index + 1}</div><div>{step.ids.length > 0 && <CardCluster ids={step.ids} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} lang={locale} />}<h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div></GuideSection>

  <GuideSection id="finish" class="section visual-guide" aria-labelledby="finish-title"><div class="eyebrow">{pilot.finish.eyebrow}</div><h2 id="finish-title">{pilot.finish.title}</h2><p class="guide-note">{pilot.finish.note}</p><div class="pilot-flow sequence-flow">{pilot.finish.items.map((step) => <article class="pilot-step"><div class="step-no">{step.title.split(' · ')[0]}</div><div>{step.ids.length > 0 && <CardCluster ids={step.ids} separators={step.separators as ('OR' | '+')[]} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} lang={locale} />}<h3>{step.title.split(' · ').slice(1).join(' · ')}</h3><p>{step.text}</p></div></article>)}</div></GuideSection>

  <GuideSection class="section visual-guide" aria-labelledby="tips-title"><div class="eyebrow">{pilot.tips.eyebrow}</div><h2 id="tips-title">{pilot.tips.title}</h2><div class="tips-grid">{pilot.tips.items.map((item) => <article class="tips-card"><div class="tips-card-art"><CardImageButton id={item.id} imageUrl={mihawkCardImageUrl} lang={locale} alt={`${item.id} ${item.title}`} /></div><div><strong>{pilot.tips.targetLabel}</strong><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></GuideSection>
  <GuideSection id="mihawk-combos" class="section visual-guide" aria-labelledby="combo-title"><div class="eyebrow">{pilot.combos.eyebrow}</div><h2 id="combo-title">{pilot.combos.title}</h2><p class="guide-note">{pilot.combos.note}</p><div class="pilot-combo-grid">{pilot.combos.items.map((combo) => <article class="pilot-combo"><div class="pilot-combo-head"><CardCluster ids={combo.cards} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} lang={locale} /><div><div class="eyebrow">{combo.number}</div><h3>{combo.title}</h3><p>{combo.summary}</p></div></div><ol class="combo-steps">{combo.steps.map((step) => <li>{step}</li>)}</ol></article>)}</div></GuideSection>

  <GuideSection class="section visual-guide"><div class="eyebrow">{pilot.defense.eyebrow}</div><h2>{pilot.defense.title}</h2><div class="defense-card"><CardCluster ids={pilot.defense.cardIds} alt={(id) => pilot.cardAlt(id)} imageUrl={mihawkCardImageUrl} lang={locale} /><div class="defense-copy">{pilot.defense.facts.map((fact) => <p>{fact}</p>)}</div></div></GuideSection>

  <GuideSection class="section visual-guide"><div class="eyebrow">{pilot.effectComparison.eyebrow}</div><h2>{pilot.effectComparison.title}</h2><div class="effect-compare">{pilot.effectComparison.items.map((item) => <article><CardImageButton id={item.id} imageUrl={mihawkCardImageUrl} lang={locale} alt={`${item.id} ${item.title}`} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></GuideSection>

  <GuideSection class="section slash-note"><div class="eyebrow">{pilot.leaderFact.eyebrow}</div><div class="slash-card"><CardImageButton id="OP14-020" imageUrl={mihawkCardImageUrl} lang={locale} alt={pilot.leaderFact.leaderAlt} /><p>{pilot.leaderFact.text}</p></div></GuideSection>
  <CardModal deck={mihawkDeck} metadataById={mihawkCardMetadataById} artVariants={mihawkCardArtVariants} imageUrl={mihawkCardImageUrl} extraCards={[]} lang={locale} />
</GuideLayout>

<style>
  :global(.ideal-pair){align-items:flex-end;gap:6px}.ideal-pair :global(.card-cluster-separator){display:inline-flex;align-items:center;align-self:center;flex:0 0 auto;color:var(--red);font-size:11px;font-weight:950;letter-spacing:.04em}
  .visual-guide,.mulligan-grid,.tips-grid,.effect-compare,.defense-card{min-width:0;max-width:100%}.visual-guide h2{max-width:760px}.disclosure{max-width:760px}.mulligan-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.visual-card{border:2px solid var(--line);border-radius:15px;background:var(--card);padding:14px;box-shadow:5px 5px 0 var(--blue);min-width:0;overflow:hidden}.visual-card:nth-child(even){background:#fff0bf;box-shadow:5px 5px 0 var(--gold)}.visual-card h3{margin:13px 0 5px}.visual-card p{margin:0;font-size:13px;overflow-wrap:anywhere}:global(.card-cluster){display:flex;gap:7px;align-items:flex-end;flex-wrap:wrap;min-width:0}:global(.card-cluster .card-image-button){width:64px;height:92px;overflow:hidden}:global(.card-cluster .card-image-button img){display:block;width:64px;height:92px;object-fit:cover;border:1px solid var(--line);border-radius:6px}.sequence-flow{gap:11px}.sequence-flow .pilot-step{min-height:145px;min-width:0}.tips-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.tips-card{display:flex;flex-direction:column;gap:11px;min-width:0;overflow:hidden;border:2px solid var(--line);border-radius:15px;background:var(--card);padding:13px;box-shadow:5px 5px 0 var(--blue)}.tips-card:nth-child(even){background:#fff0bf;box-shadow:5px 5px 0 var(--gold)}.tips-card-art{display:flex;justify-content:center}.tips-card-art :global(.card-image-button){width:72px;height:104px;overflow:hidden}.tips-card-art :global(.card-image-button img){display:block;width:72px;height:104px;object-fit:cover;border:1px solid var(--line);border-radius:6px}.tips-card strong{display:block;color:var(--red);font-size:11px;letter-spacing:.08em}.tips-card h3{margin:4px 0;font-size:18px;line-height:1}.tips-card p{margin:0;font-size:13px;overflow-wrap:anywhere}.defense-card{display:grid;grid-template-columns:minmax(280px,1fr) 1.3fr;gap:22px;align-items:center;padding:16px;border:2px solid var(--line);border-radius:15px;background:var(--gold);box-shadow:7px 7px 0 var(--line)}.defense-copy{min-width:0}.defense-copy p{margin:6px 0;font-size:14px;overflow-wrap:anywhere}.effect-compare{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.effect-compare article{min-width:0;overflow:hidden;border:2px solid var(--line);border-radius:15px;background:var(--card);padding:13px}.effect-compare article:nth-child(2){background:var(--blue)}.effect-compare article:nth-child(3){background:var(--green)}.effect-compare :global(.card-image-button){width:100px;max-width:100%;overflow:hidden}.effect-compare :global(.card-image-button img){display:block;width:100px;max-width:100%;height:145px;object-fit:cover;border:2px solid var(--line);border-radius:8px}.effect-compare h3{margin:10px 0 4px}.effect-compare p{margin:0;font-size:13px;overflow-wrap:anywhere}.slash-card{display:flex;gap:16px;align-items:center;max-width:600px;min-width:0;padding:13px;border:2px solid var(--line);border-radius:15px;background:var(--red);color:#fffdf7}.slash-card :global(.card-image-button img){width:82px;height:119px;object-fit:cover;border:2px solid var(--line);border-radius:7px}.slash-card p{margin:0;font-size:15px;overflow-wrap:anywhere}@media(max-width:900px){.mulligan-grid,.tips-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.curve-arrow{display:block;position:absolute;right:-19px;top:45%;z-index:1;font-size:20px;color:var(--red)}.curve-card:nth-child(2n) .effect-compare{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.mulligan-grid,.tips-grid{grid-template-columns:1fr 1fr}.effect-compare{grid-template-columns:1fr}.effect-compare article{display:grid;grid-template-columns:76px minmax(0,1fr);column-gap:12px;align-items:center}.effect-compare article :global(.card-image-button){grid-row:span 2;width:76px}.defense-card{grid-template-columns:1fr;gap:13px}:global(.card-cluster .card-image-button){width:56px;height:81px}:global(.card-cluster .card-image-button img){width:56px;height:81px}.need-card-art :global(.card-image-button){width:50px;height:73px;flex-basis:50px}.need-card-art :global(.card-image-button img){width:50px;height:73px}.tips-card-art :global(.card-image-button){width:64px;height:92px}.tips-card-art :global(.card-image-button img){width:64px;height:92px}.effect-compare :global(.card-image-button img){width:76px;height:110px}}@media(max-width:420px){.mulligan-grid,.tips-grid{grid-template-columns:1fr}.slash-card{align-items:flex-start}.sequence-flow .pilot-step{min-height:0}}
</style>

<style>
  .pilot-combo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.pilot-combo h3,.tips-card h3{overflow-wrap:anywhere;word-break:break-word}
  .pilot-combo{min-width:0;overflow:hidden;border:2px solid var(--line);border-radius:15px;background:var(--card);padding:14px;box-shadow:6px 6px 0 var(--ink)}
  .pilot-combo:nth-child(2n){background:var(--blue);box-shadow:6px 6px 0 var(--gold)}
  .pilot-combo-head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:13px;align-items:center}
  .pilot-combo-head h3{margin:5px 0;font-size:22px;line-height:1}
  .pilot-combo p{margin:0;font-size:13px;overflow-wrap:anywhere}
  .combo-steps{margin:12px 0 0;padding-left:22px}
  .combo-steps li{padding:7px 0;border-top:1px solid #d8d3c8;font-size:13px;overflow-wrap:anywhere}
  @media(max-width:600px){.pilot-combo-grid{grid-template-columns:1fr}.pilot-combo-head{grid-template-columns:1fr}}
</style>
