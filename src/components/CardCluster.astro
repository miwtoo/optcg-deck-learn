---
import CardImageButton from './CardImageButton.astro';
import type { Locale } from '../i18n/ui';

type AltResolver = (id: string, lang: Locale) => string;
type CardSeparator = 'OR' | '+';

interface Props {
  ids: readonly string[];
  separators?: readonly CardSeparator[];
  alt: AltResolver;
  class?: string;
  wrapperClass?: string;
  imageUrl?: (id: string) => string;
  lang?: Locale;
}

const {
  ids,
  separators,
  alt,
  class: className,
  wrapperClass = className ?? 'card-cluster',
  imageUrl,
  lang = 'en',
} = Astro.props as Props;
---

<div class={wrapperClass}>
  {ids.map((id, index) => <>
    {index > 0 && separators?.[index - 1] && <span class="card-cluster-separator">{separators[index - 1]}</span>}
    <CardImageButton id={id} alt={alt(id, lang)} imageUrl={imageUrl} lang={lang} />
  </>)}
</div>
