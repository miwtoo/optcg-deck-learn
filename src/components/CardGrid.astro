---
import { saboDeck, saboCardMetadataById, cardImageUrl as defaultImageUrl } from '../data/sabo';
const { deck = saboDeck, metadataById = saboCardMetadataById, imageUrl = defaultImageUrl, groups = ['Leader','Search / setup','Elbaph bodies','Replay & counters'], group: groupProp } = Astro.props;
const group = groupProp ?? ((role: string) => role === 'Leader' ? 'Leader' : ['Search / draw','Hand fixer','Top-three searcher','12+ activator'].some((x) => role.includes(x)) ? 'Search / setup' : ['Blocker','−3K','2K counter','Unblockable finisher','Rush payoff'].some((x) => role.includes(x)) ? 'Elbaph bodies' : 'Replay & counters');
---
{groups.map((heading: string) => <section class="deck-group"><h3>{heading} <span>{deck.filter((c: { role: string }) => group(c.role) === heading).reduce((n: number,c: { quantity: number }) => n+c.quantity,0)} cards</span></h3><div class="card-grid">{deck.filter((c: { role: string }) => group(c.role) === heading).map((card: { id: string; name: string; role: string; quantity: number }) => { const meta = metadataById[card.id]; return <button class="card" data-card-id={card.id}><img class="card-image" data-card-image-id={card.id} loading="lazy" src={imageUrl(card.id)} alt={meta?.name ?? card.name} /><small>{card.id} <span class="qty">×{card.quantity}</span></small><strong>{meta?.name ?? card.name}</strong><small>{card.role}</small></button>})}</div></section>)}
