---
import { saboDeck, saboCardMetadataById, cardImageUrl } from '../data/sabo';
const groups = ['Leader','Search / setup','Elbaph bodies','Replay & counters'];
const group = (role: string) => role === 'Leader' ? 'Leader' : ['Search / draw','Hand fixer','Top-three searcher','12+ activator'].some((x) => role.includes(x)) ? 'Search / setup' : ['Blocker','−3K','2K counter','Unblockable finisher','Rush payoff'].some((x) => role.includes(x)) ? 'Elbaph bodies' : 'Replay & counters';
---
{groups.map((heading) => <section class="deck-group"><h3>{heading} <span>{saboDeck.filter((c) => group(c.role) === heading).reduce((n,c) => n+c.quantity,0)} cards</span></h3><div class="card-grid">{saboDeck.filter((c) => group(c.role) === heading).map((card) => { const meta = saboCardMetadataById[card.id]; return <button class="card" data-card-id={card.id}><img class="card-image" data-card-image-id={card.id} loading="lazy" src={cardImageUrl(card.id)} alt={meta?.name ?? card.name} /><small>{card.id} <span class="qty">×{card.quantity}</span></small><strong>{meta?.name ?? card.name}</strong><small>{card.role}</small></button>})}</div></section>)}
