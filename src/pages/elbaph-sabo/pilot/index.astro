---
const base = `${import.meta.env.BASE_URL}/elbaph-sabo`;
import GuideLayout from '../../../layouts/GuideLayout.astro';
import CardImageButton from '../../../components/CardImageButton.astro';
import CardModal from '../../../components/CardModal.astro';
import { saboCardMetadataById } from '../../../data/sabo';
  const keep = [{ids:['OP17-080','OP17-089'],title:'First keep · Usopp / Saul',text:'They find the next piece. Saul also becomes a 12+ body.'},{ids:['OP17-095'],title:'Then keep · Zoro',text:'Zoro is a 2K counter. With a 12+ Character in play and Sabo’s leader effect active, Zoro is a 6K attacker.'},{ids:['OP15-088','OP17-119','OP17-093'],title:'Payoff · Docking Six / Loki / Luffy',text:'Keep one when your hand already has a plan.'},{ids:['OP17-087'],title:'Maybe keep · Robin',text:'Keep her when −3K makes a good attack.'}];
  const replayTargetIds = ['OP01-016','ST01-011','OP17-084','OP17-086','OP17-080','OP17-083','OP17-087','OP17-095'];
  const searchNeeds = [
    ['Need a setup card','OP17-086','Nami','Use OP17-086 Nami when you need to fix your hand. OP17-080 Usopp is another option when you need to search the top three cards.'],
    ['Need board control','OP17-087','Nico Robin','Use Nico Robin when her −3000 effect can lower an opposing Character.'],
    ['Need protection','OP17-083','Jinbe','Use Jinbe when a blocker can protect your board.'],
    ['Need a 2K counter','OP17-095','Roronoa Zoro','Use Zoro when you need a 2K counter in your hand.'],
    ['Need DON!! support','ST01-011','Brook','Use Brook when two rested DON!! cards can help your Leader or a Character.'],
    ['Need an unblockable attack','OP17-084','Tony Tony.Chopper','Use Chopper when a 12+ cost Character is in play and you need an unblockable attack.'],
  ];
  type PilotStep = [string, string[], string];
  const steps: PilotStep[] = [['Mulligan',['OP17-080','OP17-089'],'Keep Usopp or Saul first. Keep Zoro next. Keep payoff cards only with a way to reach 12+.'],['Choose your road',['OP17-086','OP17-080'],'First: plan Nami, then Usopp, then Saul or Docking Six. Second: plan Nami or Usopp, then Saul or two small bodies.'],['Early turns · find pieces',['OP17-086','OP01-016','OP17-080','OP17-089'],'First: play either Nami at 1 DON!!, then Usopp at 3. Second: play Nami or Usopp at 2. Fix the hand before you build.'],['Middle turns · build',['OP17-089','OP15-088','OP17-083'],'First: play Saul at 5, or Docking Six. Second: play Saul at 4, or Usopp plus another 2-cost.'],['Turn on thresholds',['OP17-089','OP17-119','OP17-093'],'Saul or Loki counts as 12+. The four small Elbaph bodies gain +3K. With Sabo’s leader effect active, they are 6K. Keep 1 DON!! for Sabo when an 8+ Character is live.'],['Attack safely',['OP17-087','OP17-095'],'Use Robin −3K first, then swing with your 6K bodies. Keep Jinbe ready when you need a blocker.'],['Close the turn',['OP17-093','ST01-011','OP17-098'],'Play Luffy, then play or replay Robin. If a 12+ Character is in play, Luffy gets Rush. Brook can put two rested DON!! on Sabo. Keep counters when the board needs safety.']];
  const first = [['Turn 1 · 1 DON!!',['OP17-086','OP01-016'],'Play either Nami. Use the effect to fix your hand.'],['Turn 2 · 3 DON!!',['OP17-080'],'Play Usopp and search three.'],['Turn 3 · 5 DON!!',['OP17-089','OP15-088'],'Play Saul, or use Docking Six to widen.'],['Turn 4 · 7 DON!!',['OP17-119','OP15-088'],'Play Loki, or Docking Six into a helper.'],['Turn 5 · 9 DON!!',['OP17-093','OP17-087'],'Play Luffy, then play or replay Robin. If a 12+ Character is in play, Luffy gets Rush.']];
  const second = [['Turn 1 · 2 DON!!',['OP17-086','OP17-080'],'Play Nami or Usopp to fix the hand.'],['Turn 2 · 4 DON!!',['OP17-089','OP17-080'],'Play Saul, or two 2-cost bodies.'],['Turn 3 · 6 DON!!',['OP17-089','OP17-119','OP15-088'],'Play Saul, Loki, or Docking Six.'],['Turn 4 · 8 DON!!',['OP17-093','ST01-011'],'Play Luffy and replay Brook or another helper.'],['Turn 5 · 10 DON!!',['OP17-093','OP17-087','OP17-098'],'Use Luffy, or Kong Gun with a 12+ Character, 6 rested DON!!, your board, and two valuable cost-6-or-less targets.']];
  type CurveTurn = [string, string[], string];
const curves: [string, CurveTurn[]][] = [['Going first', first as CurveTurn[]], ['Going second', second as CurveTurn[]]];
---
<GuideLayout title="Elbaph Sabo Pilot" active="pilot">
  <section class="hero"><div><div class="eyebrow">PILOT GUIDE · RED / BLACK ELBAPH</div><h1>Play Sabo<br><em>one step at a time.</em></h1><p class="lede">Find the pieces. Build wide. Reach 12+. Then swing hard.</p></div><div class="hero-art"><CardImageButton id="OP13-004" alt="Sabo leader" /><CardImageButton id="OP17-089" alt="Jaguar.D.Saul" /></div></section>
  <section class="section"><div class="eyebrow">STARTING HAND</div><h2>Keep the path, not just the shiny card.</h2><div class="overview">{keep.map((item)=><article class="keep"><div class="guidance-art">{item.ids.map((id)=><CardImageButton id={id} alt={`${id} card`} />)}</div><h3>{item.title}</h3><p>{item.text} <span class="tag">Video claim</span></p></article>)}</div></section>
   <section class="section"><div class="eyebrow">PILOT MODEL</div><h2>Small steps. Big board.</h2><div class="notice"><div class="threshold-art">{['OP13-004','OP17-089','OP17-119','OP17-093'].map((id)=><CardImageButton id={id} alt={`${id} card`} />)}</div><b>Remember three numbers.</b><p>With 4 or more Life, Sabo is 4K. With 1 DON!! and your own 8+ Character, Sabo and your Characters get +1K. Any 12+ Character gives the four small Elbaph bodies +3K. With Sabo’s leader effect active, they are 6K. Play Luffy, then play or replay Robin. Do not wait for Robin before you play Luffy. <span class="tag">Card text + guide line</span></p></div><div class="eyebrow">BEGINNER PILOT · DO THIS IN ORDER</div><div class="pilot-flow">{steps.map((step,index)=><article class="pilot-step"><div class="step-no">{index}</div><div><div class="guidance-art">{step[1].map((id)=><CardImageButton id={id} alt={`${id} card`} />)}</div><h3>{step[0]}</h3><p>{step[2]}</p><span class="tag">Simple guide</span></div></article>)}</div></section>
  <section class="section visual-guide" aria-labelledby="replay-targets-title">
    <div class="eyebrow">LUFFY · OP17-093</div>
    <h2 id="replay-targets-title">OP17-093 Luffy replay targets</h2>
    <div class="guide-callout">
      <div class="guide-callout-art"><CardImageButton id="OP17-093" alt="OP17-093 Monkey.D.Luffy" /></div>
      <p><strong>On Play:</strong> Draw 1 card. You can play 1 Character card with a cost of 2 or less from your trash. If a 12+ cost Character is in play, Luffy gets Rush.</p>
    </div>
    <p class="guide-note">These are the valid replay targets in this deck.</p>
    <div class="target-grid">
      {replayTargetIds.map((id) => {
        const card = saboCardMetadataById[id];
        return <article class="target-card"><CardImageButton id={id} alt={`${id} ${card.name}`} /><div><strong>{id}</strong><span>{card.name}</span></div></article>;
      })}
    </div>
  </section>
  <section class="section visual-guide" aria-labelledby="search-priority-title">
    <div class="eyebrow">SEARCH · USE THE BOARD STATE</div>
    <h2 id="search-priority-title">Search priority by need</h2>
    <p class="guide-note">Use these as situational choices. Your hand and board state can change the choice.</p>
    <div class="need-list">
      {searchNeeds.map(([need, id, name, text]) => <article class="need-card"><div class="need-card-art"><CardImageButton id={id} alt={`${id} ${name}`} /></div><div><strong>{need}</strong><h3>{name}</h3><p>{text}</p></div></article>)}
    </div>
  </section>
  <section class="section"><div class="eyebrow">IDEAL DON!! CURVE</div><h2>Spend DON!! in this order.</h2><p class="source">This is a sample menu, not a rule. Keep counters when the board needs safety.</p><div class="ideal-curve">{curves.map(([heading, lane])=><article class="ideal-lane"><h3>{heading}</h3>{lane.map((turn: CurveTurn)=><div class="ideal-step"><div class="ideal-pair">{turn[1].map((id)=><CardImageButton id={id} alt={`${id} card`} />)}</div><div><h4>{turn[0]}</h4><p>{turn[2]}</p><span class="tag">Card text + strong inference</span></div></div>)}</article>)}</div></section>
   <div class="notice"><a class="button" href={`${base}/combos/`}>Open Combos →</a></div>
  <CardModal />
</GuideLayout>

<style>
  .visual-guide{position:relative}
  .visual-guide h2{max-width:760px}
  .guide-callout{display:grid;grid-template-columns:76px 1fr;gap:16px;align-items:center;margin:22px 0 14px;padding:14px;border:2px solid var(--line);border-radius:16px;background:var(--gold);box-shadow:7px 7px 0 var(--line)}
   .guide-callout-art :global(.card-image-button){width:76px;height:110px;overflow:hidden}
   .guide-callout-art :global(.card-image-button img){display:block;width:76px;height:110px;object-fit:cover;border:2px solid var(--line);border-radius:7px;box-shadow:4px 4px 0 var(--red)}
  .guide-callout p,.need-card p{margin:0;font-size:14px}
  .guide-callout strong{font-weight:950}
  .guide-note{margin:14px 0;font-size:14px;color:var(--muted)}
  .target-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .target-card{display:flex;align-items:center;gap:10px;min-width:0;padding:10px;border:2px solid var(--line);border-radius:13px;background:var(--card)}
  .target-card:nth-child(3n){background:var(--blue)}
   .target-card :global(.card-image-button){flex:0 0 58px;width:58px;height:84px;overflow:hidden}
   .target-card :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}
  .target-card div{min-width:0}.target-card strong,.target-card span{display:block}.target-card strong{font-size:11px;color:var(--red);letter-spacing:.03em}.target-card span{font-size:13px;font-weight:900;line-height:1.15;margin-top:3px}
  .need-list{display:grid;gap:10px}
  .need-card{display:grid;grid-template-columns:58px 1fr;gap:12px;align-items:center;padding:11px;border:2px solid var(--line);border-radius:13px;background:var(--card)}
  .need-card:nth-child(odd){background:var(--green)}
   .need-card-art :global(.card-image-button){width:58px;height:84px;overflow:hidden}
   .need-card-art :global(.card-image-button img){display:block;width:58px;height:84px;object-fit:cover;border:1px solid var(--line);border-radius:5px}
  .need-card strong{display:block;color:var(--red);font-size:12px}.need-card h3{margin:2px 0 4px;font-size:18px;line-height:1}.need-card p{font-size:13px;line-height:1.35}
  @media(min-width:701px){.target-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.need-list{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-callout{max-width:760px}}
   @media(max-width:380px){.target-card{padding:8px;gap:7px}.target-card :global(.card-image-button),.need-card-art :global(.card-image-button){width:50px;height:73px}.target-card :global(.card-image-button img),.need-card-art :global(.card-image-button img){width:50px;height:73px}.need-card{grid-template-columns:50px 1fr;gap:9px}.target-card span{font-size:12px}}
</style>
