---
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const base = `${siteBase}/`;
const guides = [
  {
    title: 'Elbaph Sabo',
    colors: 'แดง / ดำ',
    description: 'สร้างกระดานให้กว้าง ไปให้ถึง 12+ ใช้ DON!! 1 ใบ และตัวละครค่าคอสต์ 8 ขึ้นไปของคุณ เพื่อให้ลีดเดอร์และตัวละครของคุณมีพลัง +1000',
    href: `${siteBase}/th/elbaph-sabo/`,
    image: `${siteBase}/cards/OP13-004.png`,
    imageAlt: 'การ์ดลีดเดอร์ Sabo',
  },
  {
    title: 'Dracule Mihawk',
    colors: 'เขียว / ฟัน',
    description: 'ใช้เอฟเฟกต์ของคุณก่อน พักการ์ดหนึ่งใบ แล้วทำให้ DON!! ที่ใช้งานอยู่สูงสุด 3 ใบกลับมาใช้งาน',
    href: `${siteBase}/th/mihawk/`,
    image: `${siteBase}/cards/OP14-020.png`,
    imageAlt: 'การ์ดลีดเดอร์ Dracule Mihawk',
  },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>คู่มือเด็ค · One Piece Card Game</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="mark" href={base}>ONE PIECE · DECK GUIDES</a>
        <div class="topbar-tools">
          <nav class="language-switcher" aria-label="ภาษา">
            <span aria-current="page">ไทย</span>
            <a href={base}>English</a>
          </nav>
          <span class="edition">OP17</span>
        </div>
      </header>

      <section class="intro" aria-labelledby="page-title">
        <div class="eyebrow">เรียนรู้เด็ค</div>
        <h1 id="page-title">เลือก<br /><em>คู่มือ</em></h1>
        <p class="lede">ใช้คู่มือเพื่อเรียนรู้แผนการเล่น รายการการ์ด และการเล่นสำคัญ</p>
      </section>

      <section class="guide-section" aria-labelledby="available-guides">
        <div class="section-heading">
          <div class="eyebrow">คู่มือที่มี</div>
          <h2 id="available-guides">หนึ่งเด็ค<br />เริ่มที่นี่</h2>
        </div>
        <div class="guide-grid">
          {guides.map((guide, index) => (
            <a class="guide-card" href={guide.href}>
              <div class="card-art">
                <img src={guide.image} alt={guide.imageAlt} />
                <span class="card-mark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="card-copy">
                <div class="card-meta">
                  <span class="color-label">{guide.colors}</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </div>
                <h3>{guide.title}</h3>
                <p>{guide.description}</p>
                <span class="open-guide">เปิดคู่มือ <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root{--ink:#11131d;--paper:#f5f1e8;--card:#fffdf7;--red:#e34c35;--gold:#f3c84b;--blue:#e4e0ff;--muted:#6f6d72;--line:#252631}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 ui-rounded,"Trebuchet MS",system-ui,sans-serif}
  body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;background-image:radial-gradient(var(--ink) .6px,transparent .6px);background-size:8px 8px}
  a{color:inherit}
  .shell{position:relative;max-width:1180px;margin:auto;padding:22px 22px 90px}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:18px}
  .mark{font-size:11px;font-weight:900;letter-spacing:.16em;text-decoration:none}
  .topbar-tools{display:flex;align-items:center;gap:16px}
  .language-switcher{display:flex;gap:9px;font-size:11px;font-weight:900;letter-spacing:.08em}
  .language-switcher a{text-decoration:none}
  .language-switcher a:hover,.language-switcher a:focus-visible{color:var(--red)}
  .language-switcher span{color:var(--red)}
  .edition{padding:6px 10px;border:2px solid var(--line);border-radius:99px;background:var(--gold);font-size:11px;font-weight:900;letter-spacing:.1em}
  .intro{padding:clamp(78px,13vw,170px) 0 clamp(56px,9vw,105px);max-width:800px}
  .eyebrow{color:var(--red);font-size:11px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}
  h1{margin:14px 0 22px;font-size:clamp(58px,10vw,126px);line-height:.8;letter-spacing:-.085em}
  h1 em{color:var(--red);font-style:normal}
  .lede{max-width:530px;margin:0;font-size:clamp(17px,2.2vw,21px);line-height:1.4}
  .guide-section{border-top:2px solid var(--line);padding-top:20px}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:22px}
  h2{margin:0;text-align:right;font-size:clamp(27px,4vw,48px);line-height:.9;letter-spacing:-.06em}
  .guide-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}
  .guide-card{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.2fr);border:2px solid var(--line);border-radius:17px;background:var(--card);text-decoration:none;overflow:hidden;box-shadow:8px 9px 0 var(--ink);transition:transform .2s ease,box-shadow .2s ease}
  .guide-card:hover,.guide-card:focus-visible{transform:translate(-3px,-3px);box-shadow:11px 12px 0 var(--red)}
  .guide-card:focus-visible{outline:3px solid var(--red);outline-offset:5px}
  .card-art{display:flex;justify-content:center;align-items:center;position:relative;padding:22px;background:var(--blue);overflow:hidden}
  .card-art:after{content:"";position:absolute;width:170px;height:170px;border:2px solid var(--red);border-radius:50%;opacity:.28;transform:translate(35px,45px)}
  .card-art img{position:relative;z-index:1;width:min(100%,170px);border:3px solid var(--line);border-radius:10px;box-shadow:8px 9px 0 var(--red);transform:rotate(-4deg)}
  .card-mark{position:absolute;top:12px;left:13px;z-index:2;font-size:11px;font-weight:900;letter-spacing:.12em}
  .card-copy{display:flex;flex-direction:column;align-items:flex-start;padding:22px 22px 20px}
  .card-meta{display:flex;justify-content:space-between;align-items:center;width:100%;gap:12px}
  .color-label{color:var(--red);font-size:11px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}
  .arrow{font-size:25px;line-height:1}
  h3{margin:22px 0 10px;font-size:clamp(29px,4vw,44px);line-height:.9;letter-spacing:-.06em}
  .card-copy p{margin:0;color:#34343c;line-height:1.45}
  .open-guide{margin-top:auto;padding-top:28px;font-weight:900}
  .open-guide span{color:var(--red);font-size:19px}
  @media(min-width:900px){.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:1400px){.shell{max-width:1640px}}
  @media(max-width:600px){.shell{padding:16px 16px 70px}.topbar-tools{gap:10px}.language-switcher{gap:6px}.intro{padding-top:90px}.section-heading{display:block}.section-heading h2{margin-top:12px;text-align:left}.guide-grid{grid-template-columns:1fr}.guide-card{grid-template-columns:42% 58%}.card-art{padding:14px}.card-art img{width:100%;box-shadow:6px 7px 0 var(--red)}.card-copy{padding:17px 15px 16px}h3{margin-top:18px}.open-guide{padding-top:20px}}
  @media(max-width:390px){.guide-card{grid-template-columns:1fr}.card-art{min-height:260px}.card-art img{width:170px}.card-copy{min-height:245px}}
  /* Thai needs open spacing for stacked vowel marks and taller text lines. */
  html[lang="th"] body{line-height:1.65}
  html[lang="th"] .language-switcher{letter-spacing:normal}
  html[lang="th"] .eyebrow,.color-label{letter-spacing:normal}
  html[lang="th"] h1,html[lang="th"] h2,html[lang="th"] h3{letter-spacing:normal;line-height:1.1}
  html[lang="th"] .lede,.card-copy p{line-height:1.65}
</style>
