---
import GuideLayout from '../../layouts/GuideLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import CardModal from '../../components/CardModal.astro';
import CardImageButton from '../../components/CardImageButton.astro';
import { mihawkDeck, mihawkDeckTotal, mihawkCardMetadataById, mihawkCardArtVariants, mihawkCardImageUrl } from '../../data/mihawk';

const mainDeckTotal = mihawkDeckTotal - 1;
const egmanExport = mihawkDeck.map((card) => `${card.quantity} ${card.id} ${card.name}`).join('\n');
const group = (role: string) => role === 'Leader' ? 'Leader' : role.includes('Search') || role.includes('Wano search') ? 'Search / setup' : role.includes('Event') ? 'Events' : role.includes('Rest') ? 'Rest effects' : 'Characters';
const groups = ['Leader', 'Search / setup', 'Characters', 'Rest effects', 'Events'];
---
<GuideLayout title="Green Dracule Mihawk · OP14-020" active="deck" guideBase="/mihawk" brand="ONE PIECE · OP14" navigation={['Deck', 'Pilot']}>
  <section class="hero"><div><div class="eyebrow">GREEN · SLASH</div><h1>Dracule Mihawk<br><em>OP14-020</em></h1><p class="lede">Play your effects first. Rest one card. Turn up to 3 DON!! active.</p><div class="chips"><span class="chip">OP14-020 Leader</span><span class="chip">1 leader + {mainDeckTotal} cards</span></div></div><div class="hero-art"><CardImageButton id="OP14-020" imageUrl={mihawkCardImageUrl} alt="Dracule Mihawk leader" /><CardImageButton id="OP14-119" imageUrl={mihawkCardImageUrl} alt="Dracule Mihawk" /></div></section>
  <div class="notice"><b>Leader sequence.</b> Play Characters and use their effects first. Confirm either field has a cost 5 or more Character. Rest your card. Set up to 3 DON!! active. Do not play more Characters. Use active DON!! for attacks, Events, and effects.</div>
  <section class="section"><div class="eyebrow">THE SIMPLE PLAN</div><h2>Make the rest count.</h2><div class="overview"><article class="tile"><h3>1 · Play effects first</h3><p>Play Characters and use their effects before you use the Leader effect.</p></article><article class="tile"><h3>2 · Confirm the field</h3><p>Either field must have a Character with a cost of 5 or more.</p></article><article class="tile"><h3>3 · Rest one card</h3><p>Rest a card, then set up to 3 DON!! active with the Leader effect.</p></article><article class="tile"><h3>4 · Use the DON!!</h3><p>Use active DON!! for attacks, Events, and Character effects. Do not play more Characters this turn.</p></article></div></section>
  <section class="section"><div class="flow"><span>Play effects</span><b>→</b><span>Confirm 5+</span><b>→</b><span>Rest</span><b>→</b><span>+ active DON!!</span><b>→</b><span>Attack or use Events</span></div></section>
  <section class="section"><div class="eyebrow">DEVELOPMENT</div><h2>Build at 5 or 6 DON!!</h2><div class="overview"><article class="tile"><h3>5 DON!!</h3><p>Play a 5-cost Character. This gives the Leader a valid 5+ Character for its effect.</p></article><article class="tile"><h3>6 DON!!</h3><p>ST32-003 Dracule Mihawk deploys a 5-cost-or-less Perona or Slash Character from your hand. The Leader can then rest that Character.</p></article><article class="tile"><h3>9 or 10 DON!!</h3><p>Use the active DON!! for large Characters and a finish. ST24-004 Law &amp; Bepo and OP14-119 Dracule Mihawk are finishers in this list.</p></article><article class="tile"><h3>Keep a counter</h3><p>Plan your Counter Events before you use all active DON!!. ST16-004 Shanks and ST24-004 Law &amp; Bepo are Characters in this list. OP01-055 is a Main Event, not a Counter Event.</p></article></div></section>
  <section class="section"><div class="countline"><div><div class="eyebrow">THE EXACT LIST</div><h2>1 leader + {mainDeckTotal} cards</h2></div><div class="count">✓ Counted: {mainDeckTotal}</div></div><CardGrid deck={mihawkDeck} metadataById={mihawkCardMetadataById} imageUrl={mihawkCardImageUrl} groups={groups} group={group} /><p class="source">This list uses every card and quantity in the Tone source file.</p></section>
  <section class="section export-panel"><div class="countline"><div><div class="eyebrow">EGMAN EVENTS DECK BUILDER</div><h2>Copy the deck list.</h2></div><button class="button copy-button" type="button" data-copy-export>Copy list</button></div><pre class="deck-export" data-deck-export>{egmanExport}</pre><p class="copy-status" data-copy-status role="status" aria-live="polite"></p></section>
  <div class="notice"><a class="button" href={`${import.meta.env.BASE_URL}/mihawk/pilot/`}>Open the Pilot guide →</a><p>Learn the Leader sequence and development points.</p></div>
  <section class="section"><div class="eyebrow">SOURCES</div><p>The exact list comes from the local Tone source file. The official card page confirms rules and overlapping-card interactions.</p><p><a href="https://asia-en.onepiece-cardgame.com/feature/deck/deck_102.php">Official One Piece Card Game deck page</a></p></section>
  <CardModal deck={mihawkDeck} metadataById={mihawkCardMetadataById} artVariants={mihawkCardArtVariants} imageUrl={mihawkCardImageUrl} extraCards={[]} />
</GuideLayout>

<script>
  const copyButton = document.querySelector('[data-copy-export]');
  const exportBlock = document.querySelector('[data-deck-export]');
  const copyStatus = document.querySelector('[data-copy-status]');
  copyButton?.addEventListener('click', async () => { if (!exportBlock || !copyStatus) return; await navigator.clipboard.writeText(exportBlock.textContent ?? ''); copyButton.textContent = 'Copied'; copyStatus.textContent = 'Copied to your clipboard.'; window.setTimeout(() => { copyButton.textContent = 'Copy list'; copyStatus.textContent = ''; }, 2200); });
</script>

<style>
  .export-panel{position:relative}.copy-button{font:inherit;cursor:pointer}.copy-button:focus-visible{outline:3px solid var(--red);outline-offset:3px}.deck-export{overflow:auto;margin:0;padding:18px;border:2px solid var(--line);border-radius:14px;background:var(--ink);color:#fffdf7;font:13px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.copy-status{min-height:1.5em;margin:8px 0 0;color:var(--red);font-weight:900}
</style>
